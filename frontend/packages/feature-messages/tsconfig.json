{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../.tsbuild/feature-messages",
    "tsBuildInfoFile": "../../.tsbuild/feature-messages.tsbuildinfo",
    "rootDir": "src",
    // `src/recorded/*.json` are documents captured from a running gateway, decoded by
    // `recorded.test.ts` so the mapping is checked against what the server really sends.
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "references": [{ "path": "../api" }, { "path": "../kernel" }]
}
