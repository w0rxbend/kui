{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../.tsbuild/feature-alerts",
    "tsBuildInfoFile": "../../.tsbuild/feature-alerts.tsbuildinfo",
    "rootDir": "src",
    // `src/documents/*.json`: whole events documents in the wire's own shape, decoded by
    // `wire.test.ts` so that the field names this package reads are checked against a document
    // rather than against a literal written beside the assertion.
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "references": [{ "path": "../api" }, { "path": "../kernel" }]
}
