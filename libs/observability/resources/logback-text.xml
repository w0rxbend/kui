<!--
  The human-readable log configuration, selected by `kui.telemetry.logFormat = text`.

  It exists for one situation: a developer reading a terminal, where a line of JSON is unreadable
  and the interesting part is the message. The correlation id is kept, and nothing else from the
  context map is, because a terminal line has a width and the trace id is not what a developer is
  reading at that moment. Use the JSON configuration whenever the log is going somewhere other than
  a person's eyes.
-->
<configuration>

  <appender name="text" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} [%X{correlation.id:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="WARN"/>
  <logger name="org.apache.kafka" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="text"/>
  </root>

</configuration>
