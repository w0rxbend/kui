{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "KUI Cluster Registry service",
    "version" : "1.0.0"
  },
  "paths" : {
    "/internal/v1/clusters" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Every configured cluster and its last known state",
        "description" : "The list of clusters comes from configuration overlaid by the metadata store and is always available; each row's summary is a section that can be stale or unavailable on its own.",
        "operationId" : "cluster.list",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClustersResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "One configured cluster and its last known state",
        "description" : "Answers 404 when no cluster with that id is configured; 400 when the id is malformed.",
        "operationId" : "cluster.get",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClusterDetailResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/brokers" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "The cluster's brokers, with rack, controller flag and replica counts",
        "description" : "Read from the cluster snapshot, not from a fresh admin call: the response carries the time it was scraped, and a section status saying whether that time is current.",
        "operationId" : "cluster.brokers",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrokersResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/brokers/{brokerId}/configs" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "One broker's settings, read-only",
        "description" : "Read-only in M1: BR-002 ships without edits, which arrive in M5 with read-only mode and audit. A setting the broker marks sensitive has no value and says so.",
        "operationId" : "cluster.broker.configs",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "brokerId",
            "in" : "path",
            "description" : "The broker's node id, as the cluster reports it",
            "required" : true,
            "schema" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          {
            "name" : "docs",
            "in" : "query",
            "description" : "Ask the broker for each setting's documentation (Kafka 2.6+)",
            "required" : false,
            "schema" : {
              "default" : false,
              "type" : "boolean"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrokerConfigsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: path parameter brokerId, Invalid value for: query parameter docs",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/log-dirs" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Log directories and their sizes, for one broker or for all of them",
        "description" : "A directory that is offline carries its own error while the rest of the answer is good, which is how Kafka reports a failed disk.",
        "operationId" : "cluster.logDirs",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "brokerId",
            "in" : "query",
            "description" : "Only this broker's directories; omit for every broker in the cluster",
            "required" : false,
            "schema" : {
              "type" : "integer",
              "format" : "int32"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LogDirsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: query parameter brokerId",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/refresh" : {
      "post" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Ask for this cluster to be scraped now",
        "description" : "Answers 202 with the time the request was taken. The snapshot is not new when this returns; the response exists so a button has something truthful to say.",
        "operationId" : "cluster.refresh",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "202" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RefreshAcceptedDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/profile" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "A cluster's resolved connection settings, for another KUI service",
        "description" : "The ETag is the profile's store version. A caller keeps the last profile it saw and re-fetches with If-None-Match; an unchanged profile answers 304 with no body. Every credential is removed: M1 has no consumer that builds a Kafka client from this.",
        "operationId" : "cluster.profile",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "If-None-Match",
            "in" : "header",
            "description" : "The ETag the caller already holds; '*' always fetches",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "headers" : {
              "ETag" : {
                "required" : true,
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClusterProfileDto"
                }
              }
            }
          },
          "304" : {
            "description" : "",
            "headers" : {
              "ETag" : {
                "required" : true,
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/stream" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "One event whenever a cluster's profile changes or a cluster is removed",
        "description" : "Named events: 'clusters' carries {id, version, change, at}; 'heartbeat' keeps proxies from closing an idle connection; 'error' carries the standard envelope. A frame carries no profile - a consumer that sees an unfamiliar version fetches it, which keeps credentials off every subscriber's socket and makes a dropped frame cost a fetch rather than a stale client.",
        "operationId" : "cluster.stream",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/live" : {
      "get" : {
        "description" : "Whether the process should be restarted. Never depends on an upstream.",
        "operationId" : "health.live",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LivenessReport"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready" : {
      "get" : {
        "description" : "Whether the service can serve requests now, and which checks say otherwise.",
        "operationId" : "health.ready",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/capabilities" : {
      "get" : {
        "description" : "What this service can currently do, per cluster.",
        "operationId" : "capabilities",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ServiceCapabilities"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "BrokerConfigsResponse" : {
        "title" : "BrokerConfigsResponse",
        "description" : "One broker's settings, or why they could not be read",
        "type" : "object",
        "required" : [
          "configs"
        ],
        "properties" : {
          "configs" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "BrokersResponse" : {
        "title" : "BrokersResponse",
        "description" : "The cluster's brokers, or why they could not be read",
        "type" : "object",
        "required" : [
          "brokers"
        ],
        "properties" : {
          "brokers" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "CheckResult" : {
        "title" : "CheckResult",
        "description" : "One readiness check and its result",
        "type" : "object",
        "required" : [
          "name",
          "healthy"
        ],
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "healthy" : {
            "type" : "boolean"
          },
          "detail" : {
            "type" : "string"
          }
        }
      },
      "ClusterCapability" : {
        "title" : "ClusterCapability",
        "type" : "object",
        "required" : [
          "configured",
          "status"
        ],
        "properties" : {
          "configured" : {
            "type" : "boolean"
          },
          "features" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "status" : {
            "type" : "string"
          }
        }
      },
      "ClusterDetailResponse" : {
        "title" : "ClusterDetailResponse",
        "description" : "One configured cluster and its last known state",
        "type" : "object",
        "required" : [
          "cluster"
        ],
        "properties" : {
          "cluster" : {
            "$ref" : "#/components/schemas/ClusterRowDto"
          }
        }
      },
      "ClusterProfileDto" : {
        "title" : "ClusterProfileDto",
        "description" : "A cluster's resolved connection settings, with every credential removed",
        "type" : "object",
        "required" : [
          "id",
          "name",
          "version",
          "readOnly",
          "bootstrapServers",
          "security",
          "adminTimeoutMs",
          "adminBatchSize",
          "adminParallelism",
          "updatedAt"
        ],
        "properties" : {
          "id" : {
            "description" : "a lowercase slug: ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "readOnly" : {
            "type" : "boolean"
          },
          "bootstrapServers" : {
            "type" : "string"
          },
          "security" : {
            "$ref" : "#/components/schemas/ClusterSecurityDto"
          },
          "adminTimeoutMs" : {
            "type" : "integer",
            "format" : "int64"
          },
          "adminBatchSize" : {
            "type" : "integer",
            "format" : "int32"
          },
          "adminParallelism" : {
            "type" : "integer",
            "format" : "int32"
          },
          "propertyKeys" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "updatedAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "ClusterRowDto" : {
        "title" : "ClusterRowDto",
        "description" : "One configured cluster: identity always, live data only when a scrape succeeded",
        "type" : "object",
        "required" : [
          "id",
          "name",
          "readOnly",
          "bootstrapServers",
          "security",
          "summary"
        ],
        "properties" : {
          "id" : {
            "description" : "a lowercase slug: ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "readOnly" : {
            "type" : "boolean"
          },
          "bootstrapServers" : {
            "type" : "string"
          },
          "security" : {
            "$ref" : "#/components/schemas/ClusterSecurityDto"
          },
          "summary" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "ClusterSecurityDto" : {
        "title" : "ClusterSecurityDto",
        "description" : "The shape of a cluster's security settings, with no credential in it",
        "type" : "object",
        "required" : [
          "protocol",
          "truststoreConfigured",
          "keystoreConfigured"
        ],
        "properties" : {
          "protocol" : {
            "type" : "string"
          },
          "mechanism" : {
            "type" : "string"
          },
          "truststoreConfigured" : {
            "type" : "boolean"
          },
          "keystoreConfigured" : {
            "type" : "boolean"
          }
        }
      },
      "ClustersResponse" : {
        "title" : "ClustersResponse",
        "description" : "Every configured cluster and its last known state",
        "type" : "object",
        "required" : [
          "generatedAt"
        ],
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ClusterRowDto"
            }
          },
          "generatedAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "ErrorDetail" : {
        "title" : "ErrorDetail",
        "description" : "One request field and every rule it breaks",
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "restrictions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "ErrorEnvelope" : {
        "title" : "ErrorEnvelope",
        "description" : "The error shape every KUI endpoint returns (ADR-034)",
        "type" : "object",
        "required" : [
          "code",
          "message",
          "correlationId",
          "timestamp",
          "retryable"
        ],
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ErrorDetail"
            }
          },
          "correlationId" : {
            "type" : "string"
          },
          "timestamp" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          },
          "retryable" : {
            "type" : "boolean"
          }
        }
      },
      "LivenessReport" : {
        "title" : "LivenessReport",
        "description" : "Whether the process should be restarted",
        "type" : "object",
        "required" : [
          "alive",
          "at"
        ],
        "properties" : {
          "alive" : {
            "type" : "boolean"
          },
          "at" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "LogDirsResponse" : {
        "title" : "LogDirsResponse",
        "description" : "Log directories, with a per-directory error where there is one",
        "type" : "object",
        "required" : [
          "logDirs"
        ],
        "properties" : {
          "logDirs" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "Map_ClusterId_ClusterCapability" : {
        "title" : "Map_ClusterId_ClusterCapability",
        "type" : "object",
        "additionalProperties" : {
          "$ref" : "#/components/schemas/ClusterCapability"
        }
      },
      "ReadinessReport" : {
