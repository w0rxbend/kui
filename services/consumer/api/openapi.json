{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "KUI Consumer service",
    "version" : "1.0.0"
  },
  "paths" : {
    "/internal/v1/clusters/{clusterId}/consumer-groups" : {
      "get" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "The cluster's consumer groups, with lag and pace",
        "description" : "Read from the group snapshot rather than from a live describe, so the lag and the end offsets it was computed against come from the same pass. A group whose lag could not be computed reports null, never zero, and says how many partitions were excluded. The page is wrapped in a freshness section: a cluster that has stopped answering is a 200 whose section is stale, never a bare page of figures that have quietly stopped moving.",
        "operationId" : "consumer.list",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "state",
            "in" : "query",
            "description" : "Keep only groups in these states; repeat the parameter for more than one. Empty means all",
            "required" : false,
            "schema" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            }
          },
          {
            "name" : "q",
            "in" : "query",
            "description" : "Substring match over the group id. Not over member hosts or topic names",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "sort",
            "in" : "query",
            "description" : "Which column to sort by",
            "required" : false,
            "schema" : {
              "default" : "id",
              "type" : "string"
            }
          },
          {
            "name" : "direction",
            "in" : "query",
            "description" : "Which way to sort",
            "required" : false,
            "schema" : {
              "default" : "asc",
              "type" : "string"
            }
          },
          {
            "name" : "page",
            "in" : "query",
            "description" : "Which page, numbered from one",
            "required" : false,
            "schema" : {
              "default" : 1,
              "type" : "integer",
              "format" : "int32"
            }
          },
          {
            "name" : "pageSize",
            "in" : "query",
            "description" : "How many rows a page holds. A value above the maximum is clamped, not refused",
            "required" : false,
            "schema" : {
              "default" : 25,
              "type" : "integer",
              "format" : "int32"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: query parameter page, Invalid value for: query parameter pageSize",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/consumer-groups/lag" : {
      "get" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "Which groups' lag changed since the given token",
        "description" : "The token is issued by this service and carries the snapshot version it was cut from. A client clock is not a version: sending the browser's own timestamp back, as the reference product does, silently drops or replays updates whenever the two clocks disagree.",
        "operationId" : "consumer.lag",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "group",
            "in" : "query",
            "description" : "Only these groups; repeat the parameter. Empty means every group on the cluster",
            "required" : false,
            "schema" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            }
          },
          {
            "name" : "since",
            "in" : "query",
            "description" : "The opaque token from the previous answer. Absent, unrecognised or expired means send everything",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LagDeltaDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/consumer-groups/{groupId}" : {
      "get" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "One consumer group: members, assignments and per-partition lag",
        "description" : "An unknown group answers 200 with an empty group in state DEAD, not 404: the port fabricates a dead group for a describe of a group that does not exist, and a stale bookmark should show an empty page rather than an error.",
        "operationId" : "consumer.detail",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "groupId",
            "in" : "path",
            "description" : "The consumer group id, as Kafka knows it",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupDetailDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "Delete a consumer group",
        "description" : "Mutation (consumer.group.delete). This call changes the cluster and cannot be undone. Refused with KUI-GROUP-NOT-EMPTY while the group still has members — the one refusal an operator can act on directly, by stopping the consumers.",
        "operationId" : "consumer.group.delete",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "groupId",
            "in" : "path",
            "description" : "The consumer group id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : ""
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: header X-Csrf-Token",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/topics/{topic}/consumer-groups" : {
      "get" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "Every consumer group that reads this topic, with its lag on this topic alone",
        "description" : "Feeds the gateway's topic-overview aggregation. A group's lag here is its lag on this topic, which is not its total lag whenever it consumes more than one.",
        "operationId" : "consumer.forTopic",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "topic",
            "in" : "path",
            "description" : "The topic name",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TopicConsumersDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/consumer-groups/{groupId}/offsets/plan" : {
      "post" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "What resetting this group's offsets would do",
        "description" : "Part of the consumer.offsets.reset flow. This call changes nothing. Resolves the request against the group's live offsets and returns the exact offsets that would be written, any clamping as a warning, and a token valid for five minutes. Changes nothing. Refused on a read-only cluster, so that the wizard never renders a plan that cannot be applied.",
        "operationId" : "consumer.offsets.plan",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "groupId",
            "in" : "path",
            "description" : "The consumer group id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResetPlanRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ResetPlanDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: header X-Csrf-Token, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/consumer-groups/{groupId}/offsets" : {
      "post" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "Write the offsets a plan token names",
        "description" : "Mutation (consumer.offsets.reset). This call changes the cluster and cannot be undone. Takes only a plan token. The group's state and member list are re-checked immediately before the write, because the group may have become active since the plan was made. An expired or tampered token is a validation error, never a silent re-plan.",
        "operationId" : "consumer.offsets.apply",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "groupId",
            "in" : "path",
            "description" : "The consumer group id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResetApplyRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ResetPlanDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: header X-Csrf-Token, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [
          "consumer"
        ],
        "summary" : "Delete a group's committed offsets for one topic",
        "description" : "Mutation (consumer.offsets.delete). This call changes the cluster and cannot be undone. Answers with the partitions whose offsets were removed, so that 'the group had none' and 'they were deleted' are distinguishable — which an empty 204 body cannot do.",
        "operationId" : "consumer.offsets.delete",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "groupId",
            "in" : "path",
            "description" : "The consumer group id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "topic",
            "in" : "query",
            "description" : "Delete this group's committed offsets for this topic",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DeletedOffsetsDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: header X-Csrf-Token, Invalid value for: query parameter topic",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/live" : {
      "get" : {
        "description" : "Whether the process should be restarted. Never depends on an upstream.",
        "operationId" : "health.live",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
