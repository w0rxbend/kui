                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [
          "topic"
        ],
        "summary" : "Raise a topic's partition count to what a plan token names",
        "description" : "Mutation (topic.partitions.increase). This call changes the cluster and cannot be undone. Takes only a plan token. The current count is re-read immediately before the write, so a token for twelve partitions cannot be applied to a topic somebody else has already grown to sixteen. Kafka has no way to remove a partition afterwards, and key-to-partition routing changes for every record produced from then on.",
        "operationId" : "topic.partitions.increase",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "topicName",
            "in" : "path",
            "description" : "The topic's name, as Kafka spells it",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
