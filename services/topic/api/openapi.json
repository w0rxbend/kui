{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "KUI Topic service",
    "version" : "1.0.0"
  },
  "paths" : {
    "/internal/v1/clusters/{clusterId}/topics" : {
      "get" : {
        "tags" : [
          "topic"
        ],
        "summary" : "One page of a cluster's topics",
        "description" : "The page's total is counted after every filter, including the internal-topic filter, so the page count always agrees with the rows. Read from a per-cluster snapshot: the response carries when it was taken and whether that is current.",
        "operationId" : "topic.list",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "q",
            "in" : "query",
            "description" : "Match topic names containing this text (mode=plain) or resembling it (mode=fts)",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "mode",
            "in" : "query",
            "description" : "plain for substring matching, fts for trigram matching (ADR-038)",
            "required" : false,
            "schema" : {
              "default" : "plain",
              "type" : "string"
            }
          },
          {
            "name" : "showInternal",
            "in" : "query",
            "description" : "Include Kafka's internal topics and KUI's own metadata topics",
            "required" : false,
            "schema" : {
              "default" : false,
              "type" : "boolean"
            }
          },
          {
            "name" : "sort",
            "in" : "query",
            "description" : "<field>:<asc|desc>, with field one of name, partitions, replicationFactor, outOfSyncReplicas, size, messageCount; omit for relevance order under mode=fts and name order otherwise",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "page",
            "in" : "query",
            "description" : "Which page, numbered from one",
            "required" : false,
            "schema" : {
              "default" : 1,
              "type" : "integer",
              "format" : "int32"
            }
          },
          {
            "name" : "pageSize",
            "in" : "query",
            "description" : "How many topics per page, 1 to 500",
            "required" : false,
            "schema" : {
              "default" : 25,
              "type" : "integer",
              "format" : "int32"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TopicsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: query parameter showInternal, Invalid value for: query parameter page, Invalid value for: query parameter pageSize",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [
          "topic"
        ],
        "summary" : "Create a topic",
        "description" : "Part of the topic.create flow. This call changes nothing. An absent partitions or replicationFactor is passed to the broker as absent, so its own num.partitions and default.replication.factor apply. A name the cluster already has is refused with KUI-INVALID-STATE and 409, which is a different answer from a malformed request.",
        "operationId" : "topic.create",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "X-Csrf-Token",
            "in" : "header",
            "description" : "The session's CSRF token (ADR-019). Required on every mutation",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateTopicRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CreatedTopicDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: header X-Csrf-Token, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clusters/{clusterId}/topics/{topicName}" : {
      "get" : {
        "tags" : [
          "topic"
        ],
        "summary" : "One topic, with the head of its partition table",
        "description" : "Answers 404 when no such topic exists on the cluster, and a different 404 when no such cluster is configured. The embedded partition list stops at 500 and says so; the partitions endpoint returns them all.",
        "operationId" : "topic.get",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
