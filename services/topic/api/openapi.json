          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "topicName",
            "in" : "path",
            "description" : "The topic's name, as Kafka spells it",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
