{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "KUI",
    "version" : "1.0"
  },
  "servers" : [
    {
      "url" : "/"
    }
  ],
  "paths" : {
    "/api/v1/clusters" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Every configured cluster and its last known state",
        "description" : "The list of clusters comes from configuration overlaid by the metadata store and is always available; each row's summary is a section that can be stale or unavailable on its own.",
        "operationId" : "cluster.list",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClustersResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clusters/{clusterId}" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "One configured cluster and its last known state",
        "description" : "Answers 404 when no cluster with that id is configured; 400 when the id is malformed.",
        "operationId" : "cluster.get",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClusterDetailResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clusters/{clusterId}/brokers" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "The cluster's brokers, with rack, controller flag and replica counts",
        "description" : "Read from the cluster snapshot, not from a fresh admin call: the response carries the time it was scraped, and a section status saying whether that time is current.",
        "operationId" : "cluster.brokers",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrokersResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clusters/{clusterId}/brokers/{brokerId}/configs" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "One broker's settings, read-only",
        "description" : "Read-only in M1: BR-002 ships without edits, which arrive in M5 with read-only mode and audit. A setting the broker marks sensitive has no value and says so.",
        "operationId" : "cluster.broker.configs",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "brokerId",
            "in" : "path",
            "description" : "The broker's node id, as the cluster reports it",
            "required" : true,
            "schema" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          {
            "name" : "docs",
            "in" : "query",
            "description" : "Ask the broker for each setting's documentation (Kafka 2.6+)",
            "required" : false,
            "schema" : {
              "default" : false,
              "type" : "boolean"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrokerConfigsResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clusters/{clusterId}/log-dirs" : {
      "get" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Log directories and their sizes, for one broker or for all of them",
        "description" : "A directory that is offline carries its own error while the rest of the answer is good, which is how Kafka reports a failed disk.",
        "operationId" : "cluster.logDirs",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "brokerId",
            "in" : "query",
            "description" : "Only this broker's directories; omit for every broker in the cluster",
            "required" : false,
            "schema" : {
              "type" : "integer",
              "format" : "int32"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LogDirsResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clusters/{clusterId}/refresh" : {
      "post" : {
        "tags" : [
          "cluster"
        ],
        "summary" : "Ask for this cluster to be scraped now",
        "description" : "Answers 202 with the time the request was taken. The snapshot is not new when this returns; the response exists so a button has something truthful to say.",
        "operationId" : "cluster.refresh",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          },
          {
            "name" : "clusterId",
            "in" : "path",
            "description" : "The configured cluster's slug id",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "202" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RefreshAcceptedDto"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/info" : {
      "get" : {
        "tags" : [
          "gateway"
        ],
        "summary" : "Which build of KUI is running, and what this deployment enables",
        "description" : "Unauthenticated. Contains no URL, hostname or key id: it lists configured service ids only.",
        "operationId" : "gateway.info",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppInfo"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "tags" : [
          "auth",
          "gateway"
        ],
        "summary" : "The caller's identity and the CSRF token to use for mutations",
        "operationId" : "gateway.auth.me",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthMeResponse"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [
          "auth",
          "gateway"
        ],
        "summary" : "Clears the session cookie",
        "operationId" : "gateway.auth.logout",
        "responses" : {
          "200" : {
            "description" : ""
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities" : {
      "get" : {
        "tags" : [
          "capabilities",
          "gateway"
        ],
        "summary" : "Everything KUI can and cannot do right now",
        "description" : "One entry per configured service. A service that is configured but has not been checked yet appears as degraded with reason STARTING; it is never missing, because 'not asked yet' and 'not deployed' mean different things to whoever is looking.",
        "operationId" : "gateway.capabilities.snapshot",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CapabilitySnapshot"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities/stream" : {
      "get" : {
        "tags" : [
          "capabilities",
          "gateway"
        ],
        "summary" : "A snapshot, then every capability change as it happens",
        "description" : "The first event is always a full snapshot, so a client that has just connected -- or reconnected -- never has to guess what it missed. There is no cursor and no terminal event: the stream ends when the client disconnects. A heartbeat every fifteen seconds keeps proxies from closing an idle connection.",
        "operationId" : "gateway.capabilities.stream",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities/{service}/probe" : {
      "post" : {
        "tags" : [
          "capabilities",
          "gateway"
        ],
        "summary" : "Re-check one service now and return its recomputed state",
        "description" : "What the UI's 'Retry now' button calls. It waits for the check to finish, so the entry it returns is the fresh one rather than the one that was on screen.",
        "operationId" : "gateway.capabilities.probe",
        "parameters" : [
          {
            "name" : "service",
            "in" : "path",
            "description" : "The service id to re-check",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "202" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CapabilityEntry"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AppInfo" : {
        "title" : "AppInfo",
        "description" : "Which build of KUI is running, and what this deployment enables",
        "type" : "object",
        "required" : [
          "build",
          "authType",
          "basePath",
          "features"
        ],
        "properties" : {
          "build" : {
            "$ref" : "#/components/schemas/BuildInfoDto"
          },
          "authType" : {
            "type" : "string"
          },
          "basePath" : {
            "type" : "string"
          },
          "services" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "features" : {
            "$ref" : "#/components/schemas/Map_Boolean"
          }
        }
      },
      "AuthMeResponse" : {
        "title" : "AuthMeResponse",
        "type" : "object",
        "required" : [
          "principal",
          "csrfToken",
          "authType"
        ],
        "properties" : {
          "principal" : {
            "$ref" : "#/components/schemas/PrincipalDto"
          },
          "csrfToken" : {
            "type" : "string"
          },
          "authType" : {
            "type" : "string"
          }
        }
      },
      "Available" : {
        "title" : "Available",
        "type" : "object"
      },
      "BrokerConfigsResponse" : {
        "title" : "BrokerConfigsResponse",
        "description" : "One broker's settings, or why they could not be read",
        "type" : "object",
        "required" : [
          "configs"
        ],
        "properties" : {
          "configs" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "BrokersResponse" : {
        "title" : "BrokersResponse",
        "description" : "The cluster's brokers, or why they could not be read",
        "type" : "object",
        "required" : [
          "brokers"
        ],
        "properties" : {
          "brokers" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "BuildInfoDto" : {
        "title" : "BuildInfoDto",
        "description" : "The build this process was compiled from",
        "type" : "object",
        "required" : [
          "version",
          "gitCommit",
          "gitCommitShort",
          "gitDirty",
          "builtAt",
          "scalaVersion",
          "jdkVersion"
        ],
        "properties" : {
          "version" : {
            "type" : "string"
          },
          "gitCommit" : {
            "type" : "string"
          },
          "gitCommitShort" : {
            "type" : "string"
          },
          "gitDirty" : {
            "type" : "boolean"
          },
          "builtAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          },
          "scalaVersion" : {
            "type" : "string"
          },
          "jdkVersion" : {
            "type" : "string"
          }
        }
      },
      "CapabilityEntry" : {
        "title" : "CapabilityEntry",
        "type" : "object",
        "required" : [
          "key",
          "state",
          "updatedAt"
        ],
        "properties" : {
          "key" : {
            "$ref" : "#/components/schemas/CapabilityKey"
          },
          "state" : {
            "$ref" : "#/components/schemas/CapabilityState"
          },
          "updatedAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "CapabilityKey" : {
        "title" : "CapabilityKey",
        "type" : "object",
        "required" : [
          "service"
        ],
        "properties" : {
          "service" : {
            "description" : "a KUI service: cluster, topic, message, ...",
            "type" : "string"
          },
          "cluster" : {
            "description" : "a lowercase slug: ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
            "type" : "string"
          }
        }
      },
      "CapabilitySnapshot" : {
        "title" : "CapabilitySnapshot",
        "type" : "object",
        "required" : [
          "generatedAt"
        ],
        "properties" : {
          "entries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CapabilityEntry"
            }
          },
          "generatedAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "CapabilityState" : {
        "title" : "CapabilityState",
        "oneOf" : [
          {
            "$ref" : "#/components/schemas/Available"
          },
          {
            "$ref" : "#/components/schemas/Degraded"
          },
          {
            "$ref" : "#/components/schemas/NotConfigured"
          },
          {
            "$ref" : "#/components/schemas/Unavailable"
          }
        ]
      },
      "ClusterDetailResponse" : {
        "title" : "ClusterDetailResponse",
        "description" : "One configured cluster and its last known state",
        "type" : "object",
        "required" : [
          "cluster"
        ],
        "properties" : {
          "cluster" : {
            "$ref" : "#/components/schemas/ClusterRowDto"
          }
        }
      },
      "ClusterRowDto" : {
        "title" : "ClusterRowDto",
        "description" : "One configured cluster: identity always, live data only when a scrape succeeded",
        "type" : "object",
        "required" : [
          "id",
          "name",
          "readOnly",
          "bootstrapServers",
          "security",
          "summary"
        ],
        "properties" : {
          "id" : {
            "description" : "a lowercase slug: ^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "readOnly" : {
            "type" : "boolean"
          },
          "bootstrapServers" : {
            "type" : "string"
          },
          "security" : {
            "$ref" : "#/components/schemas/ClusterSecurityDto"
          },
          "summary" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "ClusterSecurityDto" : {
        "title" : "ClusterSecurityDto",
        "description" : "The shape of a cluster's security settings, with no credential in it",
        "type" : "object",
        "required" : [
          "protocol",
          "truststoreConfigured",
          "keystoreConfigured"
        ],
        "properties" : {
          "protocol" : {
            "type" : "string"
          },
          "mechanism" : {
            "type" : "string"
          },
          "truststoreConfigured" : {
            "type" : "boolean"
          },
          "keystoreConfigured" : {
            "type" : "boolean"
          }
        }
      },
      "ClustersResponse" : {
        "title" : "ClustersResponse",
        "description" : "Every configured cluster and its last known state",
        "type" : "object",
        "required" : [
          "generatedAt"
        ],
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ClusterRowDto"
            }
          },
          "generatedAt" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "Degraded" : {
        "title" : "Degraded",
        "type" : "object",
        "required" : [
          "reason"
        ],
        "properties" : {
          "reason" : {
            "$ref" : "#/components/schemas/DegradedReason"
          }
        }
      },
      "DegradedReason" : {
        "title" : "DegradedReason",
        "type" : "object",
        "required" : [
          "code",
          "message"
        ],
        "properties" : {
          "code" : {
            "description" : "Why a capability is not available",
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "suggestedPollIntervalMs" : {
            "type" : "integer",
            "format" : "int64"
          },
          "p95Ms" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "ErrorDetail" : {
        "title" : "ErrorDetail",
        "description" : "One request field and every rule it breaks",
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "restrictions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "ErrorEnvelope" : {
        "title" : "ErrorEnvelope",
        "description" : "The error shape every KUI endpoint returns (ADR-034)",
        "type" : "object",
        "required" : [
          "code",
          "message",
          "correlationId",
          "timestamp",
          "retryable"
        ],
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ErrorDetail"
            }
          },
          "correlationId" : {
            "type" : "string"
          },
          "timestamp" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          },
          "retryable" : {
            "type" : "boolean"
          }
        }
      },
      "LogDirsResponse" : {
        "title" : "LogDirsResponse",
        "description" : "Log directories, with a per-directory error where there is one",
        "type" : "object",
        "required" : [
          "logDirs"
        ],
        "properties" : {
          "logDirs" : {
            "description" : "A part of an aggregated response: status is one of ok, stale, unavailable, forbidden, not_configured; ok and stale carry data"
          }
        }
      },
      "Map_Boolean" : {
        "title" : "Map_Boolean",
