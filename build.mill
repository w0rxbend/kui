import com.goyeau.mill.scalafix.ScalafixModule

// Compiled into the meta-build by `mill-build/build.mill`, and into `build-tests` for its unit tests.
import kui.build.{ArchitectureRules, ModuleFacts}

/** Every third-party version KUI pins, in one place.
  *
  * The numbers are the ones `DEPENDENCY_MATRIX.md` records; that file is the decision, this object
  * is the mechanical restatement the build reads. Changing a number here without changing the
  * matrix row (and the ADR the row cites) is how a build drifts away from its own documentation, so
  * always change both.
  */
object Versions {
  val scala           = "3.9.0"
  val scalaJs         = "1.22.0"
  val jdk             = "21"
  val cats            = "2.13.0"
  val catsEffect      = "3.7.1"
  val fs2             = "3.13.0"
  val tapir           = "1.13.31"
  val sttp            = "4.0.26"
  val circe           = "0.14.16"
  val circeYaml       = "0.16.1"
  val ciris           = "3.15.0"
  val iron            = "3.3.2"
  val macwire         = "2.6.7"
  val log4cats        = "2.8.0"
  val slf4j           = "2.0.18"
  val logback         = "1.6.3"
  val logstash        = "9.0"
  val otel4s          = "1.1.0"
  val otelSdk         = "1.65.0"
  val laminar         = "17.2.1"
  val waypoint        = "9.0.0"
  val scalajsDom      = "2.8.1"
  val scalaJavaTime   = "2.7.0"
  val munit           = "1.3.6"
  val munitScalacheck = "1.3.1"
  val scalacheck      = "1.20.0"
  val munitCatsEffect = "2.2.0"
  val disciplineMunit = "2.0.0"
  val testcontainers  = "0.44.1"
  val domtestutils    = "19.0.0"
}

/** Settings every KUI Scala module shares. Modules inherit strictness rather than opting into it.
  *
  * `-Werror` turns every warning into a compile error. That is deliberate and not negotiable per
  * module: a warning that can be ignored is ignored, and the backlog is never paid off.
  */
trait KuiModule extends ScalaModule with ScalafmtModule with ScalafixModule {
  def scalaVersion = Versions.scala

  def scalacOptions = Seq(
    // Opt in to the next language version's semantics, so the codebase never accumulates a
    // migration debt it has to pay all at once.
    "-source:future",
    // Braces, not significant indentation: unambiguous diffs and copy-paste that survives.
    "-no-indent",
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    // A discarded non-Unit value is almost always a forgotten effect. Both of these catch it.
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Werror"
  )
}

/** A module that additionally forbids `var`: everything under `libs`, and every service's `domain`
  * module (ADR-041 rule A1).
  *
  * scalafix has no way to scope a rule to a path from one config file, so the stricter rule set
  * lives in its own file and the modules that want it point at that file.
  */
trait KuiPureModule extends KuiModule {
  def scalafixConfig = Task { Some(mill.api.BuildCtx.workspaceRoot / ".scalafix-pure.conf") }
}

/** A module that runs on the JVM. Its own trait so that JVM-only defaults have somewhere to live. */
trait KuiJvmModule extends KuiModule

/** A module that is compiled to JavaScript by Scala.js and runs in a browser.
  *
  * `ESModule` output is what a modern browser loads natively with `<script type="module">`, and
  * what ADR-012's lazy microfrontend loading needs: `js.dynamicImport` becomes a real `import()`
  * the browser can defer, rather than everything being flattened into one file.
  */
trait KuiJsModule extends KuiModule with ScalaJSModule {
  def scalaJSVersion = Versions.scalaJs
  def moduleKind     = ModuleKind.ESModule

  // WebAssembly output is off: it is still experimental in Scala.js and browser support for it is
  // narrower than for ES modules. ADR-001 pins the JS backend.
  def scalaJSUseWebAssembly = false

  // Source maps make a stack trace from a browser point back at Scala source rather than at
  // generated JavaScript. Worth the extra artefacts.
  def scalaJSSourceMap = true
}

/** The JS half of the shipped frontend.
  *
  * `SmallModulesFor` tells the Scala.js linker to emit one small JavaScript module per class in the
  * listed packages, instead of one module for the whole program. That is what lets the shell load a
  * feature only when the user navigates to it (ADR-012). Every later milestone adds its feature
  * package to this list; a package that is missing from it still works, it just is not splittable.
  */
trait KuiFrontendModule extends KuiJsModule {
  def moduleSplitStyle = ModuleSplitStyle.SmallModulesFor("kui.ui.clusters")
}

/** JVM tests. MUnit is the only test framework (ADR-018). */
trait KuiTests extends TestModule.Munit {
  def mvnDeps = Seq(
    mvn"org.scalameta::munit::${Versions.munit}",
    mvn"org.scalameta::munit-scalacheck::${Versions.munitScalacheck}",
    mvn"org.scalacheck::scalacheck::${Versions.scalacheck}"
  )
}

/** Scala.js tests. Mixed into a module's own `ScalaJSTests`, which is where the linking lives.
  *
  * The default JavaScript environment is plain Node: no `document`, so only logic can be tested.
  * The two traits below swap that environment for one that has a DOM.
  */
trait KuiJsTests extends ScalaJSModule with KuiTests {
  // The shipped frontend is linked as ES modules (`KuiJsModule`), but a test binary is never loaded
  // by a browser: it is handed to Node by the Scala.js test adapter. Node's ES-module loader cannot
  // give the adapter's own bootstrap script the `require` function it needs, and the run dies with
  // "ReferenceError: require is not defined" before a single test starts. Linking test binaries as
  // CommonJS avoids that entirely and changes nothing about the artefact that ships.
  override def moduleKind = ModuleKind.CommonJSModule
}

/** Test sources for one platform of a cross-compiled module.
  *
  * Mill's default would put a nested `jvm.test` module's sources under `libs/kernel/jvm/test/src`,
  * which splits a cross module's tests across two directories that are 99% identical. This instead
  * reads `libs/kernel/test/src` — written once, run on both platforms — plus
  * `libs/kernel/test/src-jvm` or `-js` for the rare assertion that only makes sense on one of them.
  */
trait KuiCrossTests extends JavaModule {
  def sources = {
    // A `PlatformScalaModule`'s nested test module already has `libs/kernel/test` as its
    // `moduleDir`, shared by both platforms, so the platform name has to come from the module id
    // (`libs.kernel.jvm.test`) rather than from the path.
    val platform = moduleSegments.parts.dropRight(1).last
    Task.Sources(moduleDir / "src", moduleDir / s"src-$platform")
  }
}

/** Runs the tests against a `document` supplied by the `jsdom` npm package rather than by a real
  * browser. Fast, but jsdom is not a browser: layout, real event ordering and CSS are approximated.
  * Requires `jsdom` to be installed (see README).
  */
trait KuiJsDomTests extends ScalaJSModule with KuiJsTests {
  override def jsEnvConfig = Task { JsEnvConfig.JsDom() }
}

/** Runs the tests in a real browser engine, driven by Playwright.
  *
  * Reserved for the two SSE wrapper suites, where what is under test is the browser's own
  * `EventSource` behaviour and jsdom's approximation of it would prove nothing.
  */
trait KuiBrowserTests extends ScalaJSModule with KuiJsTests {
  override def jsEnvConfig = Task { JsEnvConfig.Playwright.chrome(headless = true, showLogs = false) }
}

object libs extends Module {

  /** Shared, platform-neutral vocabulary. KERN-001 fills it in; today it only has to compile.
    *
    * Sources live in `libs/kernel/src` and are compiled twice, once for each platform.
    * `libs/kernel/src-jvm` and `libs/kernel/src-js` hold anything that cannot be shared;
    * `PlatformScalaModule` wires those directories up from the submodule's name.
    */
  object kernel extends Module {
    trait Shared extends KuiPureModule with PlatformScalaModule

    object jvm extends Shared with KuiJvmModule {
      object test extends ScalaTests with KuiTests with KuiCrossTests
    }

    object js extends Shared with KuiJsModule {
      object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
    }
  }
}

/** A module that exists only to be resolved, never compiled.
  *
  * It declares every Maven coordinate M0 will eventually use. `resolveAll` downloads the lot, so a
  * typo in a version string fails on the first day rather than on the day the module that needs the
  * library is finally written. It is deliberately not part of any real module's classpath.
  */
object depsSmoke extends KuiModule {
  def sources = Task.Sources()

  def mvnDeps = Seq(
    // Runtime core
    mvn"org.typelevel::cats-core::${Versions.cats}",
