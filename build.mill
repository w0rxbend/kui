// Compiled into the meta-build by `mill-build/build.mill`, and into `build-tests` for its unit tests.
import kui.build.{ArchitectureRules, BuildFacts, BundleShape, CssPipeline, CssSource, ModuleFacts}

/** Every third-party version KUI pins, in one place.
  *
  * The numbers are the ones `DEPENDENCY_MATRIX.md` records; that file is the decision, this object
  * is the mechanical restatement the build reads. Changing a number here without changing the
  * matrix row (and the ADR the row cites) is how a build drifts away from its own documentation, so
  * always change both.
  */
object Versions {
  val scala           = "3.9.0"
  val scalaJs         = "1.22.0"
  val jdk             = "21"
  val cats            = "2.13.0"
  val catsEffect      = "3.7.1"
  val fs2             = "3.13.0"
  val tapir           = "1.13.31"
  val sttp            = "4.0.26"
  val circe           = "0.14.16"
  val circeYaml       = "0.16.1"
  val ciris           = "3.15.0"
  val iron            = "3.3.2"
  val macwire         = "2.6.7"
  val chimney         = "2.0.0-RC1"
  val apispec         = "0.11.10"
  val log4cats        = "2.8.0"
  val slf4j           = "2.0.18"
  val logback         = "1.6.3"
  val logstash        = "9.0"
  val otel4s          = "1.1.0"
  val otelSdk         = "1.65.0"
  val laminar         = "17.2.1"
  val waypoint        = "9.0.0"
  val scalajsDom      = "2.8.1"
  val scalaJavaTime   = "2.7.0"
  val kafkaClients    = "4.3.1"
  val fs2Kafka        = "4.0.0"
  val snappy          = "1.1.10.8"
  val lz4             = "1.11.2"
  val caffeine        = "3.2.4"
  // Held in one place because two unrelated libraries drag it in: `dev.cel` (which resolves 4.35.1
  // on its own) and Confluent's Protobuf deserializer. They share a classpath in every `app`
  // module, so KUI names the version rather than letting resolution pick.
  val protobuf        = "4.36.1"
  val cel             = "0.14.0"
  val nimbus          = "10.9.1"
  val bouncycastle    = "1.85"
  val munit           = "1.3.6"
  val munitScalacheck = "1.3.1"
  val scalacheck      = "1.20.0"
  val munitCatsEffect = "2.2.0"
  val disciplineMunit = "2.0.0"
  val testcontainers  = "0.44.1"
  // The Java artefact, resolved separately from the Scala wrapper above: `org.testcontainers:kafka`
  // does not exist at any version; the module is published as `testcontainers-kafka` (M1 F-15).
  val testcontainersJava = "2.0.5"
  // Playwright and the browser build it downloads are pinned together (BUILD-006 spike 3): the
  // library only speaks to the browser revision it shipped with, so bumping one means bumping both.
  val playwright        = "1.62.0"
  val playwrightBrowser = "chromium 151.0.7922.34 (playwright build 1234)"
  val domtestutils    = "19.0.0"
}

/** Settings every KUI Scala module shares. Modules inherit strictness rather than opting into it.
  *
  * `-Werror` turns every warning into a compile error. That is deliberate and not negotiable per
  * module: a warning that can be ignored is ignored, and the backlog is never paid off.
  */
trait KuiModule extends ScalaModule with ScalafmtModule with ScalafixModule {
  def scalaVersion = Versions.scala

  def scalacOptions = Seq(
    // Opt in to the next language version's semantics, so the codebase never accumulates a
    // migration debt it has to pay all at once.
    "-source:future",
    // Braces, not significant indentation: unambiguous diffs and copy-paste that survives.
    "-no-indent",
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    // A discarded non-Unit value is almost always a forgotten effect. Both of these catch it.
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Werror"
  )
}

/** A module that additionally forbids `var`: everything under `libs`, and every service's `domain`
  * module (ADR-041 rule A1).
  *
  * scalafix has no way to scope a rule to a path from one config file, so the stricter rule set
  * lives in its own file and the modules that want it point at that file.
  */
trait KuiPureModule extends KuiModule {
  def scalafixConfig = Task { Some(mill.api.BuildCtx.workspaceRoot / ".scalafix-pure.conf") }
}

/** A module that runs on the JVM. Its own trait so that JVM-only defaults have somewhere to live. */
trait KuiJvmModule extends KuiModule

/** A module that is compiled to JavaScript by Scala.js and runs in a browser.
  *
  * `ESModule` output is what a modern browser loads natively with `<script type="module">`, and
  * what ADR-012's lazy microfrontend loading needs: `js.dynamicImport` becomes a real `import()`
  * the browser can defer, rather than everything being flattened into one file.
  */
trait KuiJsModule extends KuiModule with ScalaJSModule {
  def scalaJSVersion = Versions.scalaJs
  def moduleKind     = ModuleKind.ESModule

  // WebAssembly output is off: it is still experimental in Scala.js and browser support for it is
  // narrower than for ES modules. ADR-001 pins the JS backend.
  def scalaJSUseWebAssembly = false

  // Source maps make a stack trace from a browser point back at Scala source rather than at
  // generated JavaScript. Worth the extra artefacts.
  def scalaJSSourceMap = true
}

/** The JS half of the shipped frontend.
  *
  * `SmallModulesFor` tells the Scala.js linker to emit one small JavaScript module per class in the
  * listed packages, instead of one module for the whole program. That is what lets the shell load a
  * feature only when the user navigates to it (ADR-012). Every later milestone adds its feature
  * package to this list; a package that is missing from it still works, it just is not splittable.
  */
trait KuiFrontendModule extends KuiJsModule {
  def moduleSplitStyle = ModuleSplitStyle.SmallModulesFor("kui.ui.clusters", "kui.ui.topics")

  /** The feature microfrontends that must be linked into modules of their own (ADR-012).
    *
    * Empty until UI-012 creates the first one. `checkBundleShape` skips on an empty list rather
    * than passing, so an accidentally emptied list is visible in the build log instead of silently
    * turning the check off. UI-012 adds
    * `BundleShape.Feature("kui.ui.clusters.ClustersFeature", "kui.ui.clusters")` here.
    */
  def bundleFeatures: Seq[BundleShape.Feature] = Seq.empty

  /** The largest `main.js` the shell may ship, uncompressed.
    *
    * 1.5 MB is a starting budget, not a measurement: it is roughly what a Laminar shell plus its
    * runtime costs today, with room to grow. Raising it is allowed; raising it without saying why
    * in the commit body is how a budget stops meaning anything.
    */
  def bundleSizeBudgetBytes: T[Long] = Task { 1_500_000L }

  /** Fails the build when the linked frontend is not shaped the way ADR-012 needs.
    *
    * Runs `fullLinkJS` first — the shape only exists in the optimised output, because the fast
    * linker does not do the same module splitting — and then applies `kui.build.BundleShape`'s
    * rules to what landed in the output directory.
    */
  def checkBundleShape(): Task.Command[Unit] = Task.Command {
    val linked      = fullLinkJS().dest.path
    val linkedFiles = os.list(linked).filter(os.isFile)
    val mainJs      = linked / "main.js"

    val output = BundleShape.LinkerOutput(
      fileNames = linkedFiles.map(_.last).toSeq,
      mainJsContent = if (os.exists(mainJs)) os.read(mainJs) else "",
      mainJsSizeBytes = if (os.exists(mainJs)) os.size(mainJs) else 0L
    )

    BundleShape.check(output, bundleFeatures, bundleSizeBudgetBytes()) match {
      case BundleShape.Result.Skipped(message) => println(message)
      case BundleShape.Result.Passed(message)  => println(message)
      case BundleShape.Result.Failed(problems) =>
        Task.fail(s"checkBundleShape: ${problems.size} problem(s):\n${problems.map("  " + _).mkString("\n")}")
    }
  }
}

/** JVM tests. MUnit is the only test framework (ADR-018). */
trait KuiTests extends TestModule.Munit {
  def mvnDeps = Seq(
    mvn"org.scalameta::munit::${Versions.munit}",
    mvn"org.scalameta::munit-scalacheck::${Versions.munitScalacheck}",
    mvn"org.scalacheck::scalacheck::${Versions.scalacheck}"
  )
}

/** Scala.js tests. Mixed into a module's own `ScalaJSTests`, which is where the linking lives.
  *
  * The default JavaScript environment is plain Node: no `document`, so only logic can be tested.
  * The two traits below swap that environment for one that has a DOM.
  */
trait KuiJsTests extends ScalaJSModule with KuiTests {
  // The shipped frontend is linked as ES modules (`KuiJsModule`), but a test binary is never loaded
  // by a browser: it is handed to Node by the Scala.js test adapter. Node's ES-module loader cannot
  // give the adapter's own bootstrap script the `require` function it needs, and the run dies with
  // "ReferenceError: require is not defined" before a single test starts. Linking test binaries as
  // CommonJS avoids that entirely and changes nothing about the artefact that ships.
  override def moduleKind = ModuleKind.CommonJSModule
}

/** Test sources for one platform of a cross-compiled module.
  *
  * Mill's default would put a nested `jvm.test` module's sources under `libs/kernel/jvm/test/src`,
  * which splits a cross module's tests across two directories that are 99% identical. This instead
  * reads `libs/kernel/test/src` — written once, run on both platforms — plus
  * `libs/kernel/test/src-jvm` or `-js` for the rare assertion that only makes sense on one of them.
  */
trait KuiCrossTests extends JavaModule {
  def sources = {
    // A `PlatformScalaModule`'s nested test module already has `libs/kernel/test` as its
    // `moduleDir`, shared by both platforms, so the platform name has to come from the module id
    // (`libs.kernel.jvm.test`) rather than from the path.
    val platform = moduleSegments.parts.dropRight(1).last
    Task.Sources(moduleDir / "src", moduleDir / s"src-$platform")
  }
}

/** Runs the tests against a `document` supplied by the `jsdom` npm package rather than by a real
  * browser. Fast, but jsdom is not a browser: layout, real event ordering and CSS are approximated.
  * Requires `jsdom` to be installed (see README).
  */
trait KuiJsDomTests extends ScalaJSModule with KuiJsTests {
  override def jsEnvConfig = Task { JsEnvConfig.JsDom() }

  // jsdom loads the test binary the way a browser loads a classic `<script>` tag, so it accepts
  // neither the ES modules the shipped frontend is linked as nor the CommonJS that `KuiJsTests`
  // switches plain Node tests to. `NoModule` is the plain-script output, and it is the only input
  // this environment supports (`JSDOMNodeJSEnv.validateInput`). Nothing about the artefact that
  // ships is affected: this is the file handed to jsdom, not the one served to a browser.
  override def moduleKind = ModuleKind.NoModule

  // A single-file output cannot also be split into one module per feature, and the linker refuses
  // the combination outright. Splitting is a production concern (ADR-012's lazy feature loading);
  // `checkBundleShape` asserts it on the real `fullLinkJS` output, so nothing is lost by linking the
  // test binary as one file.
  override def moduleSplitStyle = ModuleSplitStyle.FewestModules
}

/** Runs the tests in a real browser engine, driven by Playwright.
  *
  * Reserved for the two SSE wrapper suites, where what is under test is the browser's own
  * `EventSource` behaviour and jsdom's approximation of it would prove nothing.
  */
trait KuiBrowserTests extends ScalaJSModule with KuiJsTests {
  override def jsEnvConfig = Task { JsEnvConfig.Playwright.chrome(headless = true, showLogs = false) }
}

object libs extends Module {

  /** Shared, platform-neutral vocabulary. KERN-001 fills it in; today it only has to compile.
    *
    * Sources live in `libs/kernel/src` and are compiled twice, once for each platform.
    * `libs/kernel/src-jvm` and `libs/kernel/src-js` hold anything that cannot be shared;
    * `PlatformScalaModule` wires those directories up from the submodule's name.
    */
  object kernel extends Module {

    /** cats-core is the kernel's only dependency, and it earns its place twice: `Validated` and
      * `NonEmptyList` are what let a form report every bad field at once instead of the first one
      * (`kui.kernel.Validation`), and cats is the vocabulary every layer above already speaks. It is
      * pure Scala with a Scala.js build, so it does not compromise the cross-compilation.
      */
    trait Shared extends KuiPureModule with PlatformScalaModule {
      def mvnDeps = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")
    }

    object jvm extends Shared with KuiJvmModule {
      // The kernel's own suites use the shared generators, which live in `libs/testkit` so that every
      // module gets them. That is a test-scope edge only: `libs.testkit` depends on the kernel, not
      // the other way round.
      object test extends ScalaTests with KuiTests with KuiCrossTests {
        def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)
      }
    }

    object js extends Shared with KuiJsModule {
      // A browser has no `java.time`, and the kernel needs `Instant` (an error that records when a
      // circuit opened, a capability that records when it went away). scala-java-time is a
      // reimplementation of the java.time API in Scala, so the same source compiles for both
      // platforms instead of the JS half growing a parallel date type.
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

      object test extends ScalaJSTests with KuiJsTests with KuiCrossTests {
        def moduleDeps = super.moduleDeps ++ Seq(testkit.js)
      }
    }
  }

  /** Wire shapes shared by every service: the error envelope, the capability and section DTOs, and
    * the codecs that give kernel types a JSON and a Tapir form.
    *
    * It is the only module allowed to know how a kernel type is serialised (ADR-007). Cross-compiled,
    * because the browser decodes exactly what the gateway encodes, from the same source.
    */
  object contractsCore extends Module {

    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "libs" / "contracts-core"

    trait Shared extends KuiPureModule with PlatformScalaModule {
      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
      )
    }

    // `security-core` is here for one type: `KuiEndpoint.internal` puts the signed principal on
    // every `/internal/v1` endpoint, and `SignedPrincipal` is security-core's. The edge points the
    // only way it can — security-core knows nothing about the wire, and both modules are
    // cross-compiled, so a browser-side contract still compiles.
    object jvm extends Shared with KuiJvmModule {
      def moduleDeps = Seq(kernel.jvm, securityCore.jvm)

      object test extends ScalaTests with KuiTests with KuiCrossTests
    }

    object js extends Shared with KuiJsModule {
      def moduleDeps = Seq(kernel.js, securityCore.js)
      def mvnDeps =
        super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

      object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
    }
  }

  /** Test infrastructure every other module's suites share: generators, fakes, stub upstreams and
    * the golden-file helper.
    *
    * It declares its test libraries as main dependencies rather than test ones, because this module
    * *is* test infrastructure — a consumer depends on it from its own test scope. Cross-compiled, so
    * a browser suite gets the same generators as a JVM one; the parts that need a filesystem or a
    * JVM-only library (the golden files, the stub HTTP upstream) live in the JVM source set.
    */
  object testkit extends Module {
    trait Shared extends KuiPureModule with PlatformScalaModule {
      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"org.scalameta::munit::${Versions.munit}",
        mvn"org.scalameta::munit-scalacheck::${Versions.munitScalacheck}",
        mvn"org.scalacheck::scalacheck::${Versions.scalacheck}",
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        mvn"org.typelevel::discipline-munit::${Versions.disciplineMunit}"
      )
    }

    object jvm extends Shared with KuiJvmModule {
      // `libs.config` is here for one type: `ClusterConfigs.forBroker` hands a suite the
      // `kui.clusters[]` entry that reaches a fixture broker. The alternative is every suite
      // hand-building a `ClusterConfig`, which is exactly the hand-built profile the three-mode
      // parity suite must not use — it would compare KUI against a value the test wrote itself.
      // One edge, between two libraries, in the direction libraries already point (rule A5).
      def moduleDeps = Seq(kernel.jvm, contractsCore.jvm, config)

      // Declared here and used from later tasks: the stub upstream (HTTP-002 onward), the
      // Testcontainers topology (CFGOP-004) and the certificate helpers the TLS tests need.
      // `kafka-clients` is on this classpath because a fixture that starts a broker has to be able
      // to talk to it — rule A10 names `libs/testkit` on its allow-list for exactly that.
      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
        mvn"com.dimafeng::testcontainers-scala-munit::${Versions.testcontainers}",
        mvn"org.testcontainers:testcontainers-kafka:${Versions.testcontainersJava}",
        mvn"org.apache.kafka:kafka-clients:${Versions.kafkaClients}",
        mvn"org.bouncycastle:bcpkix-jdk18on:${Versions.bouncycastle}"
      )

      object test extends ScalaTests with KuiTests with KuiCrossTests {
        def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)
      }
    }

    object js extends Shared with KuiJsModule {
      def moduleDeps = Seq(kernel.js, contractsCore.js)
      def mvnDeps =
        super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

      object test extends ScalaJSTests with KuiJsTests with KuiCrossTests {
        def moduleDeps = super.moduleDeps ++ Seq(testkit.js)
      }
    }
  }

  /** The typed configuration model and the loader that fills it in.
    *
    * JVM only, and deliberately so: configuration is read from files, environment variables and
    * command-line flags, none of which a browser has. Nothing in this module is shared with the
    * frontend, so it is a plain module rather than a cross-compiled one.
    */
  object config extends KuiPureModule with KuiJvmModule {
    // `libs.kafkaAuth` is here for the metadata store's own Kafka clients (ADR-042 §5): the store
    // *is* a Kafka client, and rendering its `security.*` properties anywhere else would be the
    // second copy of the renderer that `libs/kafka-auth` exists to prevent. ADR-041's rule A10
    // names `libs/config` on its allow-list for exactly this reason.
    def moduleDeps = Seq(kernel.jvm, kafkaAuth)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"is.cir::ciris::${Versions.ciris}",
      mvn"io.circe::circe-core::${Versions.circe}",
      mvn"io.circe::circe-parser::${Versions.circe}",
      mvn"io.circe::circe-yaml::${Versions.circeYaml}",
      // The metadata store (ADR-042) lives here: `changes` is an fs2 stream and the adapters log what
      // they skip at startup. Neither is used by the Ciris loader above.
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"co.fs2::fs2-io::${Versions.fs2}",
      mvn"org.typelevel::fs2-kafka::${Versions.fs2Kafka}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      // The store's own broker-backed suite (STORE-009). It runs one container of its own rather
      // than sharing `libs/testkit`'s cluster topology, because the store cluster and a managed
      // cluster are different fixtures with different lifetimes.
      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.dimafeng::testcontainers-scala-munit::${Versions.testcontainers}",
        mvn"com.dimafeng::testcontainers-scala-kafka::${Versions.testcontainers}",
        mvn"org.apache.kafka:kafka-clients:${Versions.kafkaClients}",
        // `TestControl` is what lets the store's replay loop be tested without a broker: a replay that
        // never reaches the log's end has to fail inside its timeout, and asserting that against real
        // time would mean a suite that waits thirty seconds to prove one line of code.
        mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
      )
    }
  }

  /** Kafka client properties assembled from the typed security ADT (ADR-022).
    *
    * Pure by design and separate from `libs/kafka` on purpose: it renders strings, holds no
    * Kafka client, and is therefore unit-testable as string-in / string-out. That is what
    * makes the JAAS injection property test cheap, and what will let M8's configuration
    * wizard validate a candidate profile without dragging a Kafka client into the process
    * doing the validating.
    */
  object kafkaAuth extends KuiPureModule with KuiJvmModule {
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "libs" / "kafka-auth"

    def moduleDeps = Seq(kernel.jvm)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"co.fs2::fs2-io::${Versions.fs2}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)
      // Test scope only, and it is the point of the suite: what this module renders is parsed
      // back by Kafka's own JAAS parser, not by a reimplementation that could share its bug.
      def mvnDeps =
        super.mvnDeps() ++ Seq(mvn"org.apache.kafka:kafka-clients:${Versions.kafkaClients}")
    }
  }

  /** The only module in KUI that opens a Kafka connection, alongside `libs/config`'s
    * metadata-store adapter and each service's `infrastructure` module (rule A10).
    *
    * Admin calls go through the raw `Admin` client behind a `KafkaFuture` bridge; consumers and
    * producers go through fs2-kafka. `libs/kafka/CLIENT-CHOICE.md` records why, with the
    * verification against the pinned fs2-kafka release.
    */
  object kafka extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, kafkaAuth, observability)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"co.fs2::fs2-io::${Versions.fs2}",
      mvn"org.typelevel::fs2-kafka::${Versions.fs2Kafka}",
      // Pinned above fs2-kafka's own transitive release, per DEPENDENCY_MATRIX.md.
      mvn"org.apache.kafka:kafka-clients:${Versions.kafkaClients}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
    )

    // Named by neither the compiler nor this module's code: the Kafka client loads them
    // reflectively when a topic is compressed. On the compile classpath they would be an
    // invitation to import a codec class directly.
    def runMvnDeps = Seq(
      mvn"org.xerial.snappy:snappy-java:${Versions.snappy}",
      mvn"at.yawk.lz4:lz4-java:${Versions.lz4}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
      )
    }
  }

  /** Traces, metrics and structured logs, set up the same way in every process.
    *
    * JVM only. The OpenTelemetry SDK and Logback exist only on the JVM, and nothing in the browser
    * exports a span: the frontend's own diagnostics are a separate concern (ADR-009).
    *
    * The exporters and the log encoder are `runMvnDeps` rather than `mvnDeps` on purpose. Code in
    * this module names none of them — it configures them through the OpenTelemetry autoconfigure
    * mechanism and through `logback.xml` — so putting them on the compile classpath would let a
    * future edit reach for a Logback or exporter class directly, which is exactly the coupling
    * ADR-008 and ADR-009 keep out.
    */
  object observability extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, config)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"org.typelevel::log4cats-slf4j::${Versions.log4cats}",
      mvn"org.slf4j:slf4j-api:${Versions.slf4j}",
      mvn"org.typelevel::otel4s-core::${Versions.otel4s}",
      mvn"org.typelevel::otel4s-oteljava::${Versions.otel4s}",
      mvn"io.opentelemetry:opentelemetry-sdk:${Versions.otelSdk}",
      mvn"io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:${Versions.otelSdk}",
      mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-otel4s-tracing::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-metrics::${Versions.tapir}",
      mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}"
    )

    def runMvnDeps = Seq(
      mvn"ch.qos.logback:logback-classic:${Versions.logback}",
      mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
      mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
      // TD-002: the only Prometheus exporter in the Java SDK line, and it is published as an
      // alpha. ADR-009 accepts that knowingly rather than pulling in a second SDK for one endpoint.
      mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      // The suites assert against what was actually recorded rather than against a mock, so they
      // need a real SDK with an in-memory exporter, and a real Logback to prove the MDC bridge.
      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        // Not only so the suites can capture output: `logback.xml` in this module's resources is on
        // the test classpath, so Logback parses it during the run. A typo in it — or an encoder
        // that is not on the classpath — fails the suite instead of failing in production.
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
      )
    }
  }

  /** The bytes-to-text boundary: the `Serde[F]` SPI, the built-in serdes, the resolution order and
    * the mandatory `Fallback` (ADR-028, ARCHITECTURE.md §4.4).
    *
    * It knows nothing about Kafka and nothing about the Schema Registry. A deployment with neither a
    * registry nor `libs/serde-confluent` on its classpath still browses topics of JSON, strings and
    * integers, and that is what makes the Confluent stack optional at runtime (ADR-014) rather than
    * optional in principle.
    *
    * circe is here for one reason: `DeserializeResult.properties` is `Map[String, Json]`, and the
    * `Json` serde has to decide whether bytes are JSON. The *wire* codecs for these types belong to
    * `services/message/contract`, not here (ADR-007).
    */
  object serde extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, observability)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"io.circe::circe-core::${Versions.circe}",
      mvn"io.circe::circe-parser::${Versions.circe}",
      mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
      )
    }
  }

  /** The two caching primitives of ADR-016: a single value that is refreshed on a schedule and keeps
    * answering while the refresh fails (ADR-016).
    *
    * `BoundedCache`, ADR-016's other primitive, arrived in M3 with its first callers: the compiled
    * CEL programs of `libs/filter` and the Schema-Registry schemas of `libs/serde-confluent`. A
    * cache with no caller has no TTL policy to test against, which is why it waited.
    */
  object cache extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, observability)

    def mvnDeps = Seq(
      // Caffeine backs `BoundedCache` (ADR-016). It is a Java library with its own eviction and
      // expiry, wrapped behind a `Resource` and an effect-typed interface so that nothing outside
      // this module ever names a Caffeine type.
      mvn"com.github.ben-manes.caffeine:caffeine:${Versions.caffeine}",
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        // Virtual time: the whole contract of this module is about what happens after thirty
        // seconds of a failing upstream, and a suite that slept through that would be slow and
        // flaky at once.
        mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
      )
    }
  }

  /** The only user-programmable predicate KUI accepts (ADR-017).
    *
    * CEL — Google's Common Expression Language — is a sandboxed, non-Turing-complete expression
    * language with a linear-time regex engine, which is what makes it safe to evaluate an expression
    * a user typed against every record of a browse. `libs/filter` is the only module that names a
    * `dev.cel` type; rule A12 keeps it that way, so the fallback if CEL ever has to go is a second
    * implementation of `MessagePredicate` rather than a redesign.
    */
  object filter extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, cache, observability)

    def mvnDeps = Seq(
      mvn"dev.cel:cel:${Versions.cel}",
      // Pinned, not inherited. CEL 0.14.0 resolves protobuf-java 4.35.1 and
      // `libs/serde-confluent` pins 4.36.1; on an `app` module's classpath both are present and
      // whichever wins is decided by resolution order rather than by anyone's choice. Naming the
      // same version in both places makes the agreement explicit and a future divergence a diff.
      mvn"com.google.protobuf:protobuf-java:${Versions.protobuf}",
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"io.circe::circe-core::${Versions.circe}",
      mvn"io.circe::circe-parser::${Versions.circe}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        // The evaluation deadline is the whole contract of the CEL engine, and a suite that slept
        // through it would be slow and flaky at once.
        mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
      )
    }
  }

  /** How every KUI process serves and consumes HTTP.
    *
    * The server, the one place `KuiError` becomes an HTTP response, the base-path and CORS
    * handling, the health endpoints, the resilient upstream client and the SSE helpers. JVM only:
    * Netty is a server, and a browser has no use for any of it.
    */
  object http extends KuiPureModule with KuiJvmModule {
    def moduleDeps = Seq(kernel.jvm, contractsCore.jvm, securityCore.jvm, config, observability)

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"co.fs2::fs2-io::${Versions.fs2}",
      mvn"io.circe::circe-core::${Versions.circe}",
      mvn"io.circe::circe-parser::${Versions.circe}",
      mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}",
      mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
      mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        // Deterministic virtual time. The readiness and upstream suites assert timing — that three
        // one-second checks finish in one second, that a breaker reopens after its reset — and
        // sleeping through those would make the suite slow and flaky at once.
        mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
        mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
        // The suites bind a real port and speak HTTP to it, so Logback has to be able to configure
        // itself from `libs/observability`'s `logback.xml`, which is on the test classpath.
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
      )
    }
  }

  /** The security vocabulary: who a caller is, and how a service checks that claim.
    *
    * Cross-compiled like the kernel, because the browser renders what a principal may do. The JOSE
    * library that signs and verifies the header is confined to `src-jvm`: it exists only on the JVM,
    * and `./mill checkArchitecture` (rule A6) fails the build if it ever reaches the shared or the
    * browser half.
    */
  object securityCore extends Module {

    // Mill names a module's directory after the Scala identifier, which would be `libs/securityCore`.
    // The repository layout in ARCHITECTURE.md §16 spells library directories with a dash, and the
    // directory is what a person navigates, so the identifier bends rather than the layout.
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "libs" / "security-core"

    trait Shared extends KuiPureModule with PlatformScalaModule {
      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}"
      )
    }

    object jvm extends Shared with KuiJvmModule {
      def moduleDeps = Seq(kernel.jvm)
      def mvnDeps    = super.mvnDeps() ++ Seq(mvn"com.nimbusds:nimbus-jose-jwt:${Versions.nimbus}")

      object test extends ScalaTests with KuiTests with KuiCrossTests
    }

    object js extends Shared with KuiJsModule {
      def moduleDeps = Seq(kernel.js)
      def mvnDeps =
        super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

      object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
    }
  }
}

/** The product version, shown in the shell footer and reported in bug reports.
  *
  * It lives here rather than in a file the application reads at runtime because the browser has no
  * filesystem: the only way a Scala.js program can know which build it is, is for the build to
  * compile the answer in (see `uiKernel`'s `BuildInfo`).
  */
def kuiVersion: T[String] = Task { "0.1.0-SNAPSHOT" }

/** When this build ran, as an RFC 3339 instant in UTC.
  *
  * A `Task`, so every generated `BuildInfo` in one build agrees about it rather than each recording
  * the moment its own module happened to be compiled. Truncated to whole seconds: sub-second
  * precision in a build timestamp is noise, and the value is rendered in a UI footer and read aloud
  * in support conversations.
  */
def builtAt: T[String] = Task {
  java.time.Instant.now().truncatedTo(java.time.temporal.ChronoUnit.SECONDS).toString
}

/** What git says about the working tree, or `None` when it cannot be asked.
  *
  * Both commands may fail for perfectly good reasons — a release tarball has no `.git` directory, and
  * a build container often does not either — so a failure becomes `None` rather than a failed build.
  * `kui.build.BuildFacts` decides what a `None` means, and its suite covers the states a build machine
  * can be in that a test cannot arrange for real.
  */
private def git(arguments: String*): Option[String] =
  scala.util
    .Try(os.proc("git" +: arguments).call(cwd = mill.api.BuildCtx.workspaceRoot, check = false))
    .toOption
    .filter(_.exitCode == 0)
    .map(_.out.text())

/** A module that has the build's own facts compiled into it as `object BuildInfo`.
  *
  * A running process cannot look them up: a container has no git checkout and a browser has no
  * filesystem. The only way for `GET /api/v1/info` to answer "which version are you running?" is for
  * the build to hand the answer over as source.
  *
  * Mill's ready-made `BuildInfo` lives in a contrib plugin. Generating seven string literals by hand
  * is smaller than taking that dependency, and it keeps the generated shape visible here and its
  * rules unit-tested in `build-tests`.
  */
trait KuiBuildInfoModule extends KuiModule {

  /** The package the generated object lands in. Each module names its own, so two deployables never
    * collide on the classpath.
    */
  def buildInfoPackage: String

  def buildInfoObject: String = "BuildInfo"

  def buildInfoSource: T[PathRef] = Task {
    val facts = BuildFacts.of(
      version = kuiVersion(),
      revParse = git("rev-parse", "HEAD"),
      status = git("status", "--porcelain"),
      builtAt = builtAt(),
      scalaVersion = Versions.scala,
      jdkVersion = System.getProperty("java.version", BuildFacts.Unknown)
    )

    val file = Task.dest / s"${buildInfoObject}.scala"
    os.write(file, BuildFacts.render(buildInfoPackage, buildInfoObject, facts))
    PathRef(file)
  }

  def generatedSources = Task { super.generatedSources() :+ buildInfoSource() }
}

/** Everything that runs in a browser.
  *
  * `ui-kernel` is the design system and the shell's plumbing: tokens, primitives, the feature
  * loading contract. Feature microfrontends (`ui-clusters`, `ui-topics`, …) arrive in later
  * milestones as sibling modules; each adds its package to `KuiFrontendModule`'s split list and its
  * CSS directory to `cssModules` below.
  */
object frontend extends Module {

  object uiKernel extends KuiFrontendModule {

    /** Mill names a module's directory after the Scala object, which would put these sources in
      * `frontend/uiKernel`. Directories in this repository are kebab-case (`libs/kernel`,
      * `services/gateway`, and `ui-clusters`, `ui-topics` to come), and a Scala identifier cannot
      * contain a hyphen without backticks — which would then leak into every task name a developer
      * types. Renaming the directory here keeps `frontend/ui-kernel` on disk and
      * `frontend.uiKernel.compile` on the command line.
      */
    def moduleDir = super.moduleDir / os.up / "ui-kernel"

    // `contracts-core` brings the error envelope and the capability DTOs the `ApiClient` and the
    // capability store decode (UI-005, UI-008); `security-core` brings `Principal`, which is what
    // `/auth/me` answers with. Both are cross-compiled, so the browser decodes exactly the shapes
    // the gateway encodes, from the same source.
    def moduleDeps = Seq(libs.kernel.js, libs.contractsCore.js, libs.securityCore.js)

    def mvnDeps = Seq(
      mvn"com.raquo::laminar::${Versions.laminar}",
      mvn"com.raquo::airstream::${Versions.laminar}",
      mvn"com.raquo::waypoint::${Versions.waypoint}",
      mvn"org.scala-js::scalajs-dom::${Versions.scalajsDom}",
      mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
      mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4::${Versions.tapir}",
      // sttp's JS backend decodes timestamps with `java.time`, which the JVM supplies and the
      // browser does not; this is the Scala.js re-implementation of it.
      mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}"
    )

    /** Writes the build's own facts into a Scala source file that is compiled with the module.
      *
      * A browser has no filesystem and no environment variables, so the only way for frontend code
      * to know which build it is, is for the build to hand it the answer as source. Mill's
      * ready-made `BuildInfo` lives in a contrib plugin; generating one field by hand is smaller
      * than taking that dependency, and keeps the generated code visible in this file.
      */
    def buildInfoSource: T[PathRef] = Task {
      val file = Task.dest / "KernelBuildInfo.scala"
      os.write(
        file,
        s"""package kui.ui.kernel
           |
           |/** Generated by `build.mill`. Do not edit; read it through `Kernel`. */
           |private[kernel] object KernelBuildInfo {
           |  val version: String = "${kuiVersion()}"
           |}
           |""".stripMargin
      )
      PathRef(file)
    }

    def generatedSources = Task { super.generatedSources() :+ buildInfoSource() }

    /** Runs under jsdom, not plain Node, because almost everything in this module touches
      * `document`. See `docs/development/toolchain.md` for the `NODE_PATH` jsdom needs.
      */
    object test extends ScalaJSTests with KuiJsDomTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.raquo::domtestutils::${Versions.domtestutils}")

      /** Compiles the token stylesheet and its documentation into the test binary as plain strings.
        *
        * `ContrastSuite` has to read both: the CSS to learn every colour's value, and
        * `docs/frontend/tokens.md` to learn which foreground/background pairs are supposed to be
        * legible. Code compiled by Scala.js has no filesystem — it runs inside a JavaScript engine —
        * so a test cannot open either file at run time. Handing them to it as generated source is
        * the way to keep the *documentation* as the single source of truth for the pair list, which
        * is the point: adding a pair to the table makes the test check it, and adding a token
        * without adding its pair leaves the omission visible in one place.
        *
        * Both files are declared as `Task.Sources`, which is what lets Mill read them at all and
        * what makes the generator re-run when either changes.
        */
      def tokenFixtureInputs: T[Seq[PathRef]] = Task.Sources(
        mill.api.BuildCtx.workspaceRoot / "frontend" / "ui-kernel" / "resources" / "css" / "10-tokens.css",
        mill.api.BuildCtx.workspaceRoot / "docs" / "frontend" / "tokens.md"
      )

      def tokenFixtureSource: T[PathRef] = Task {
        val contents = tokenFixtureInputs().map(input => os.read(input.path))
        val file     = Task.dest / "TokenFixtures.scala"

        // Deliberately not `stripMargin`: the documentation is full of Markdown tables, and every
        // one of their rows starts with the `|` that `stripMargin` would eat.
        os.write(
          file,
          List(
            "package kui.ui.kernel.theme",
            "",
            "/** Generated by `build.mill` from the token stylesheet and its documentation. Do not edit. */",
            "private[theme] object TokenFixtures {",
            s"  val stylesheet: String = \"\"\"${contents(0)}\"\"\"",
            s"  val documentation: String = \"\"\"${contents(1)}\"\"\"",
            "}",
            ""
          ).mkString("\n")
        )
        PathRef(file)
      }

      /** Compiles the gateway's own golden capability snapshot into the test binary.
        *
        * `CapabilityStoreSuite` decodes the exact bytes the server's golden test writes, which is what
        * makes "the browser and the gateway agree about this document" a checked fact rather than a
        * hope. The file is read from `libs/contracts-core` rather than copied here on purpose: a copy
        * is a second source of truth, and the day the server's golden file changes the copy would keep
        * passing while the real contract had moved.
        *
        * Code compiled by Scala.js has no filesystem, so the bytes have to arrive as generated source;
        * declaring the file as a `Task.Source` is what makes Mill re-run this when it changes.
        */
      def capabilityFixtureInput: T[Seq[PathRef]] = Task.Sources(
        mill.api.BuildCtx.workspaceRoot / "libs" / "contracts-core" / "test" / "resources" / "golden" /
          "capabilities-snapshot.json"
      )

      def capabilityFixtureSource: T[PathRef] = Task {
        val contents = os.read(capabilityFixtureInput().head.path)
        val file     = Task.dest / "CapabilityFixtures.scala"
        os.write(
          file,
          List(
            "package kui.ui.kernel.state",
            "",
            "/** Generated by `build.mill` from the gateway's golden capability snapshot. Do not edit. */",
            "private[state] object CapabilityFixtures {",
            s"  val snapshot: String = \"\"\"$contents\"\"\"",
            "}",
            ""
          ).mkString("\n")
        )
        PathRef(file)
      }

      def generatedSources = Task {
        super.generatedSources() ++ Seq(tokenFixtureSource(), capabilityFixtureSource())
      }
    }
  }

  /** The application: the router, the layout and the shell's own pages.
    *
    * It is the Scala.js *entry point* — the one `main` ADR-012 allows — and therefore the module the
    * linker is run on. Feature microfrontends are reached through `FeatureRegistry`'s dynamic
    * imports rather than from here, which is what lets the linker put each of them in a JavaScript
    * module the browser downloads only when it is needed.
    */
  object uiShell extends KuiFrontendModule {

    // Kebab-case on disk, camelCase on the command line, for the same reason as `uiKernel`.
    def moduleDir = super.moduleDir / os.up / "ui-shell"

    // `services.gateway.contract.js` brings the capability endpoints: the snapshot the store polls
    // with and the probe the "Retry now" button calls (UI-010). They are cross-compiled, so the
    // browser calls exactly the endpoints the gateway serves, from the same source.
    // `uiClusters` is a compile-time dependency and a *run-time* one only through
    // `js.dynamicImport`: the shell names `ClustersRoutes` (static data) directly and
    // `ClustersFeature` only inside the import thunk, which is what lets the linker put the
    // feature in a module of its own (ADR-012). `checkBundleShape` fails the build if that line
    // is ever crossed.
    def moduleDeps = Seq(uiKernel, uiClusters, uiTopics, services.gateway.contract.js)

    def mvnDeps = Seq(mvn"com.raquo::waypoint::${Versions.waypoint}")

    /** The feature microfrontends that must end up in JavaScript modules of their own. */
    def bundleFeatures = Seq(
      BundleShape.Feature("kui.ui.clusters.ClustersFeature", "kui.ui.clusters"),
      BundleShape.Feature("kui.ui.topics.TopicsFeature", "kui.ui.topics")
    )

    object test extends ScalaJSTests with KuiJsDomTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.raquo::domtestutils::${Versions.domtestutils}")
    }
  }

  /** The first feature microfrontend, and the shape every later one copies.
    *
    * It depends on `ui-kernel` for the design system and on the cluster service's cross-compiled
    * contract, so the browser decodes exactly what the service encodes, from the same source. It
    * depends on the shell not at all, and it must not: the shell depends on every feature, and the
    * reverse edge would be a cycle as well as the end of lazy loading.
    */
  object uiClusters extends KuiFrontendModule {

    // Kebab-case on disk, camelCase on the command line, for the same reason as `uiKernel`.
    def moduleDir = super.moduleDir / os.up / "ui-clusters"

    // `services.gateway.contract.js` alongside the cluster service's own: five of the six endpoints
    // this module calls are proxied through the gateway unchanged and so keep the service's DTOs,
    // but `GET /api/v1/clusters` is *aggregated* by the gateway (CLAPI-007) and answers with
    // `ClusterOverviewDto`, which is the gateway's type. Decoding it against the service's
    // `ClustersResponse` is what made the dashboard render "No clusters yet" against a working
    // broker; see `ClustersApi.clusters`.
    def moduleDeps = Seq(uiKernel, services.cluster.contract.js, services.gateway.contract.js)

    /** jsdom, since M1's dashboard.
      *
      * It used to be plain Node, on the grounds that the only suite here was about a state machine.
      * That stopped being true when this module gained screens: the milestone's headline criterion —
      * *the row of an unreachable cluster is still focusable and still clickable* — is a statement
      * about what ends up in the DOM and cannot be asserted anywhere else. Pure suites keep running
      * unchanged under jsdom.
      */
    object test extends ScalaJSTests with KuiJsDomTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.raquo::domtestutils::${Versions.domtestutils}")
    }
  }

  /** The topic explorer (M2), and the second microfrontend.
    *
    * It depends on `services.topic.contract.js` so the browser decodes exactly what the topic service
    * encodes, from the same source (ADR-003), and on the shell not at all: the shell depends on every
    * feature, and the reverse edge would be a cycle as well as the end of lazy loading.
    *
    * Its test module additionally depends on `services.topic.contract.js.test`, which is where the
    * contract's committed sample documents live as constants. Decoding *those exact bytes* in the browser's
    * own suite is the seam test M1 lacked: the dashboard decoded `ClustersResponse` while the gateway sent
    * `ClusterOverviewDto`, every response decoded successfully into zero rows, and the page rendered "No
    * clusters yet" against a working broker with no error anywhere. Both modules' suites were green because
    * each tested itself against its own idea of the payload. Copying the documents into this module would
    * have reproduced exactly that — two beliefs, free to drift — so nothing is copied and the one committed
    * document is read from both sides.
    */
  object uiTopics extends KuiFrontendModule {

    // Kebab-case on disk, camelCase on the command line, for the same reason as `uiKernel`.
    def moduleDir = super.moduleDir / os.up / "ui-topics"

    // `services.gateway.contract.js` alongside the topic service's own, for the reason `uiClusters`
    // records: the topic *overview* is a gateway aggregation and answers with the gateway's type,
    // while the other five endpoints are proxied through untouched and keep the service's. Decoding
    // an aggregation against the owning service's type is what made the M1 dashboard render "No
    // clusters yet" against a working broker.
    def moduleDeps = Seq(uiKernel, services.topic.contract.js, services.gateway.contract.js)

    object test extends ScalaJSTests with KuiJsDomTests {
      def moduleDeps = super.moduleDeps ++ Seq(services.topic.contract.js.test)
      def mvnDeps    = super.mvnDeps() ++ Seq(mvn"com.raquo::domtestutils::${Versions.domtestutils}")
    }
  }

  /** The message explorer (M3).
    *
    * It starts life holding only the parts of the table view that are pure — the JSON flattener and its
    * path syntax — because those are the piece of M3's frontend that depends on nothing at all and can be
    * proved correct on their own. The typed clients, the screens and the dependency on
    * `services.message.contract.js` arrive with MSG-034, once that contract exists; like `uiClusters`, this
    * module will decode exactly what the message service encodes, from the same source, and will depend on
    * the shell not at all.
    */
  object uiMessages extends KuiFrontendModule {

    // Kebab-case on disk, camelCase on the command line, for the same reason as `uiKernel`.
    def moduleDir = super.moduleDir / os.up / "ui-messages"

    def moduleDeps = Seq(uiKernel)

    object test extends ScalaJSTests with KuiJsDomTests {
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.raquo::domtestutils::${Versions.domtestutils}")
    }
  }

  /** Every frontend module whose `resources/css` directory contributes to `kui.css`, in no
    * particular order — `CssPipeline` decides the cascade, not this list.
    */
  private def cssModules: Seq[KuiFrontendModule] = Seq(uiKernel, uiShell, uiClusters, uiTopics)

  /** Concatenates every module's CSS into one `kui.css` (ADR-024).
    *
    * The ordering rules, and the reasoning behind them, live in `kui.build.CssPipeline` so that they
    * can be unit-tested by `build-tests` rather than only observed by running the build.
    */
  def css: T[PathRef] = Task {
    val resourceRoots = Task.traverse(cssModules)(_.resources)()

    val sources = cssModules.zip(resourceRoots).flatMap { (module, roots) =>
      val moduleName = module.moduleSegments.parts.last
      roots
        .map(_.path / "css")
        .filter(os.exists)
        .flatMap(directory => os.list(directory).filter(_.ext == "css"))
        .sorted
        .map(file => CssSource(moduleName, file.last, os.read(file)))
    }.toList

    val stylesheet = Task.dest / "kui.css"
    os.write(stylesheet, CssPipeline.concatenate(sources))
    println(s"frontend.css: ${sources.size} source file(s) -> $stylesheet")
    PathRef(stylesheet)
  }

  /** The linked frontend, laid out the way the classpath has to see it.
    *
    * `StaticRoutes` serves `/ui/...` from the classpath under `/web`, so a browser asking for
    * `/ui/main.js` makes the server look for the classpath resource `web/main.js`. This task builds
    * a directory containing exactly that `web` directory — every file the Scala.js linker produced
    * (`main.js`, one module per split feature, and the source maps) plus `kui.css` — and hands it
    * back as a resource root.
    *
    * A deployable adds it to its own `resources`, which is what puts those files inside the
    * assembled jar and therefore inside the container image. Without it the images serve
    * `index.html` and then answer the `main.js` request it points at with `index.html` again — the
    * single-page fallback doing exactly what it is supposed to do for an unknown path — so the
    * browser loads an HTML document as a JavaScript module and the application never starts. The
    * API worked, which is why the Compose smoke test passed and nobody noticed until a real browser
    * opened the page.
    *
    * `fullLinkJS` and not `fastLinkJS`, for two reasons: it is the optimised output a release is
    * supposed to ship, and it is the only one that is actually split into per-feature modules, which
    * is the ADR-012 behaviour E2E-001 asserts on. The development loop does not go through here at
    * all — `devClassPath` puts symbolic links to the fast-linker output in front of everything, so a
    * developer still gets a re-link and a refresh.
    */
  def bundle: T[PathRef] = Task {
    val web = Task.dest / "web"
    os.makeDir.all(web)

    val linked = uiShell.fullLinkJS().dest.path
    val jsFiles = os.list(linked).filter(os.isFile)
    jsFiles.foreach(file => os.copy.into(file, web, replaceExisting = true))
    os.copy.into(css().path, web, replaceExisting = true)

    println(s"frontend.bundle: ${jsFiles.size} linker file(s) + kui.css -> $web")
    PathRef(Task.dest)
  }
}

/** The eleven services. Each is one module tree with the layers of `ARCHITECTURE.md` §3, and the
  * edges between those layers are checked by `checkArchitecture` rather than by review (ADR-041).
  */
object services extends Module {

  /** The Cluster Registry and Topology context (`docs/domain/context-map.md`), and — because it is
    * the first one written — the shape every other service copies.
    *
    * M0 builds only the layers that have something to hold: `domain`, `application` and `contract`.
    * There is deliberately no `infrastructure` module, because there is no adapter to write yet and
    * an empty module is an invitation to put something in it.
    */
  object cluster extends Module {

    /** Business rules and the ports they are stated in terms of. Rule A1 allows it `libs/kernel`
      * and cats-core and nothing else; `KuiPureModule` additionally forbids `var` here.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** Use cases. It may see the domain and the effect libraries, and it may not see the wire:
      * rule A3 fails the build on tapir, circe, `libs/contracts-core` or `libs/http` reaching it.
      * The types a use case returns are its own, and `api` maps them (ADR-033).
      */
    object application extends KuiJvmModule {
      // `libs.cache` carries the `SnapshotCell` the topology snapshot is held in. It has no Kafka
      // dependency, so rule A10 is unaffected, and it is not a wire module, so rule A3 is too.
      def moduleDeps = Seq(domain, libs.cache)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        // The domain's test module carries the profile and topology fixtures every suite here
        // builds on. A generator of a domain type cannot live in `libs/testkit`: rule A5 forbids a
        // library depending on a service.
        def moduleDeps =
          super.moduleDeps ++ Seq(libs.testkit.jvm, services.cluster.domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time: the refresh loop's whole contract is about what happens after thirty
          // seconds, and a suite that slept through that would be slow and flaky at once.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The adapters. The only module in the cluster tree with a Kafka client on its classpath
      * (rule A10), and the only one `app` is allowed to see (rule A9).
      */
    object infrastructure extends KuiJvmModule {
      def moduleDeps =
        Seq(domain, libs.kafka, libs.config, libs.cache, libs.kernel.jvm, libs.observability)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
        def mvnDeps =
          super.mvnDeps() ++ Seq(
            mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
            mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
            mvn"com.dimafeng::testcontainers-scala-munit::${Versions.testcontainers}",
            mvn"com.dimafeng::testcontainers-scala-kafka::${Versions.testcontainers}"
          )
      }
    }

    /** The published wire shape: Tapir endpoints, their DTOs and the codecs for them.
      *
      * Cross-compiled, because the browser decodes exactly what this service encodes, from the
      * same source (ADR-003). That is also why rule A2 forbids it any edge to `domain` or
      * `application`: a contract that reached into the domain would drag the domain into the
      * browser build.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends ScalaTests with KuiTests with KuiCrossTests
      }

      object js extends Shared with KuiJsModule {
        def moduleDeps = Seq(libs.contractsCore.js, libs.securityCore.js)
        def mvnDeps =
          super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

        object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
      }
    }

    /** The shared consumer of this service's profile contract (ADR-046).
      *
      * It exists because four Kafka-facing services will need to turn a cluster id into a live
      * connection, and a protocol implemented four times — a conditional fetch, a change
      * subscription, a fallback poll, a last-known cache and a cancellation path — is a protocol
      * implemented four different ways, with the differences invisible from inside any one of them.
      *
      * Rule A11 admits `contract` and `client` across a service boundary and nothing else, and it
      * names `client` explicitly so that a second module of this kind has to be argued in the commit
      * that adds it. It holds no Kafka client (A10 forbids it one) and no domain: it maps a DTO to a
      * `libs/kernel` value and stops.
      */
    object client extends KuiJvmModule {
      def moduleDeps = Seq(contract.jvm, libs.http, libs.kernel.jvm, libs.securityCore.jvm, libs.observability)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time. Everything this module's contract is about happens after a delay — the
          // fallback poll, the reconnect backoff, the sticky failure instant — and a suite that
          // waited for those would be slow and flaky at the same time.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
          mvn"io.circe::circe-parser::${Versions.circe}"
        )
      }
    }

    /** Server logic: contract to application, `KuiError` to the HTTP envelope, principal verification and
      * the OpenAPI document (`ARCHITECTURE.md` §3).
      *
      * This is the only layer allowed to see both an application type and a wire type, which is what makes
      * the mapping between them (ADR-033) possible without rule A3 failing the build.
      */
    object api extends KuiJvmModule {
      def moduleDeps = Seq(
        application,
        contract.jvm,
        libs.kernel.jvm,
        libs.contractsCore.jvm,
        libs.securityCore.jvm,
        libs.observability,
        libs.http
      )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
        // The circe encoders for the OpenAPI model. `tapir-openapi-docs` builds the document; this is
        // what turns it into the JSON that is committed beside this module.
        mvn"com.softwaremill.sttp.apispec::openapi-circe::${Versions.apispec}",
        // ADR-033: DTO mapping, in the layer ADR-041 puts it in.
        mvn"io.scalaland::chimney::${Versions.chimney}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      /** Where the generated document is committed. It lives beside the module rather than under `docs/`
        * because GW-007 merges the services' documents by walking the module tree.
        */
      private def openApiTarget: String = (moduleDir / "openapi.json").toString

      def openApi(): Command[Unit] = Task.Command {
        runMain("kui.cluster.api.OpenApiDocument", openApiTarget)()
      }

      def openApiCheck(): Command[Unit] = Task.Command {
        runMain("kui.cluster.api.OpenApiDocument", openApiTarget, "--check")()
      }

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // `TestControl` runs a route against a virtual clock, which is how "the refresh endpoint
          // answers without waiting for the scrape" is asserted as a fact rather than as a stopwatch
          // reading that would be flaky on a loaded machine.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
          // The stub interpreter runs the real interceptor chain and the real routes without a socket.
          // A bound port would add seconds per case and prove nothing this module is responsible for.
          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          // A real meter, in memory: `kui.principal.rejected` is only proven emitted by reading it back
          // off a recording meter, not by asserting against a fake that could agree with a bug.
          mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}"
        )
      }
    }

    /** The composition root and the `main`. The only module allowed to name `IO` (ADR-010).
      *
      * It carries its own `BuildInfo` because a running process cannot look one up: a container has no git
      * checkout, so the only way a startup log line can say which build it is is for the build to hand the
      * answer over as source.
      */
    object app extends KuiJvmModule with KuiBuildInfoModule {
      def buildInfoPackage = "kui.cluster.app"
      def buildInfoObject = "ClusterBuildInfo"

      // `infrastructure` is here and nowhere else: rule A9 lets a service's `app` module - and only its
      // `app` module - see its own adapters, because the composition root is the one place that is
      // supposed to know which adapter implements which port.
      def moduleDeps =
        Seq(api, infrastructure, libs.cache, libs.config, libs.kafka, libs.observability, libs.http)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-io::${Versions.fs2}",
        mvn"com.softwaremill.macwire::util::${Versions.macwire}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}",
        mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}"
      )

      /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
        * telemetry exporters. None is named in code — Logback is configured by the XML in
        * `libs/observability`'s resources and the exporters by OpenTelemetry's autoconfigure mechanism — so
        * they stay off the compile classpath.
        */
      def runMvnDeps = Seq(
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
        mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
        mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
      )

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // `TestControl` is what makes the once-a-minute unsigned-codec warning testable: the
          // suite advances two minutes of virtual time instead of waiting two real ones.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
          mvn"ch.qos.logback:logback-classic:${Versions.logback}",
          mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
        )
      }
    }
  }

  /** The message service: browsing, producing, resending and tracking records (M3).
    *
    * It is the milestone's headline service and the first one whose primary response is a *stream*
    * rather than a document, which is why its layers are the ones ADR-035 was written for.
    */
  object message extends Module {

    /** Business rules and the ports they are stated in terms of. Rule A1 allows it `libs/kernel` and
      * cats-core and nothing else, which is why `DecodedRecord` carries a `String` and not circe's
      * `Json`, and why every port here is declared in domain terms and satisfied by an adapter over
      * the library types.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: browsing, seeking, publishing, and the cursor that makes "next page" work on any
      * replica.
      *
      * Rule A3 fails the build if tapir, circe, `libs/contracts-core` or `libs/http` reaches it: the
      * types a use case returns are its own, and `api` maps them (ADR-033). That is why the cursor is
      * serialised by hand in this module rather than with a derived JSON codec — a cursor is a
      * compatibility surface, and a derived codec would let a field rename silently invalidate every
      * cursor a browser is holding.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.cache)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        // The domain's test module carries the generators every suite here builds on. A generator of a
        // domain type cannot live in `libs/testkit`: rule A5 forbids a library depending on a service.
        def moduleDeps =
          super.moduleDeps ++ Seq(libs.testkit.jvm, services.message.domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-message-service`.
      *
      * Cross-compiled for the reason every KUI contract is: the browser decodes exactly what the
      * service encodes, from one file (ADR-003). This module matters more than most, because the
      * documents it declares are the ones that arrive inside a stream — and a stream is the one
      * place where a mismatched decoder shows an empty screen with no error anywhere, which is
      * exactly M1's second integration defect.
      *
      * Rule A2 forbids it an edge into `domain` or `application`, which is why every value it names
      * comes from `libs/kernel` or `libs/contracts-core`.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends ScalaTests with KuiTests with KuiCrossTests
      }

      object js extends Shared with KuiJsModule {
        def moduleDeps = Seq(libs.contractsCore.js, libs.securityCore.js)
        def mvnDeps =
          super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

        object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
      }
    }
  }

  /** The one process a browser ever talks to (ADR-004 §3).
    *
    * The gateway owns no domain and holds no Kafka client. It is edge concerns only: the header policy, the
    * session and CSRF boundary, the capability registry, contract-derived routing to the other services, the
    * static assets and the merged OpenAPI document. `checkArchitecture` rules A4 and A8 are what keep it
    * that way — A4 forbids it any edge into another service's private layers, A8 forbids it a Kafka client.
    *
    * ADR-041's Amendment 1 exempts it from rule A3, which keeps a domain-owning service's `application`
    * layer off the wire. The exemption is not a loosening: the gateway's subject matter *is* other services'
    * published contracts, so an `application` layer that could not name a contract type would have nothing
    * left to say.
    */
  object gateway extends Module {

    /** The gateway's use cases: the capability fold (GW-003) and the ports the edge is stated in terms of.
      *
      * It sees `libs/contracts-core` because a capability state is a contract type, and the whole job of
      * this layer is to decide what that document should say.
      */
    object application extends KuiJvmModule {
      // `libs.http` is here for the resilience vocabulary (`CircuitEvent`, `CircuitState`) and the SSE
      // event type the `ServiceClient` port speaks in. ADR-041 §1a admits both for the gateway
      // specifically, because the gateway owns no domain and the wire *is* its subject matter.
      // The two contract modules are here for the dashboard aggregation (CLAPI-007): it calls the cluster
      // service's published `listClusters` endpoint and answers with the gateway's own overview document.
      // Both are wire types, which is the exception ADR-041 §1a already grants this module - the gateway
      // owns no domain, so the wire *is* its subject matter, and a mapper between two DTOs it can already
      // see would be ceremony with no boundary behind it.
      def moduleDeps =
        Seq(
          libs.kernel.jvm,
          libs.contractsCore.jvm,
          libs.securityCore.jvm,
          libs.config,
          libs.http,
          contract.jvm,
          services.cluster.contract.jvm,
          // The topic-overview aggregation calls the topic service's own `getTopic` endpoint, through the
          // same generic client every proxied route uses. Rule A11 admits another service's `contract` and
          // nothing else, which is exactly what is wanted here: the gateway names an endpoint value and a
          // DTO, and knows nothing about how the topic service produces either.
          services.topic.contract.jvm
        )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The gateway's own published wire shape: `/api/v1/info`, the `/api/v1/auth` endpoints and the capability
      * endpoints. Cross-compiled for the same reason every other contract is (ADR-003): the browser decodes
      * exactly what the gateway encodes, from the same source.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends ScalaTests with KuiTests with KuiCrossTests
      }

      object js extends Shared with KuiJsModule {
        def moduleDeps = Seq(libs.contractsCore.js, libs.securityCore.js)
        def mvnDeps =
          super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

        object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
      }
    }

    /** The edge itself: the header policy, the routes, the static assets and the OpenAPI document.
      *
      * It depends on `services.cluster.contract.jvm` and will depend on every other service's contract as
      * they arrive. That is the only edge A4 allows, and it is the whole design: the gateway derives its
      * routes from endpoint values another team published, so a path it serves cannot drift from the path
      * that service serves.
      */
    object api extends KuiJvmModule with KuiBuildInfoModule {
      def buildInfoPackage = "kui.gateway.api"
      def buildInfoObject = "GatewayBuildInfo"

      def moduleDeps = Seq(
        application,
        contract.jvm,
        cluster.contract.jvm,
        // Rule A11: another service's `contract` is the only layer the gateway may see, and rule A4 says
        // the same thing for the gateway specifically. One entry per service in `ServiceContracts`, one
        // module dependency here, and nothing else in the gateway knows the topic service exists.
        topic.contract.jvm,
        libs.kernel.jvm,
        libs.contractsCore.jvm,
        libs.securityCore.jvm,
        libs.config,
        libs.observability,
        libs.http
      )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"co.fs2::fs2-io::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
        // The Tapir *client* interpreter, and the sttp transport under it. This is what turns another
        // service's published endpoint value into an outbound request (GW-002), which is why the gateway
        // never hand-writes an upstream path.
        mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4::${Versions.tapir}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        // Declared now and used by GW-008 (static assets) and GW-007 (the merged OpenAPI document). They
        // are here rather than added later so that a resolution failure surfaces on the first build of this
        // module rather than on the day someone writes the code that needs them.
        mvn"com.softwaremill.sttp.tapir::tapir-files::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      /** Where the merged, product-wide OpenAPI document is committed.
        *
        * `docs/api/openapi.json` and not a file beside this module, because it documents the whole product
        * rather than one service: it is the artefact an integrator is pointed at, and it belongs with the
        * rest of the published documentation.
        */
      private def openApiTarget: String =
        (mill.api.BuildCtx.workspaceRoot / "docs" / "api" / "openapi.json").toString

      /** Regenerates the committed document. */
      def openApi(): Command[Unit] = Task.Command {
        runMain("kui.gateway.api.openapi.OpenApiDocument", openApiTarget)()
      }

      /** Fails when the committed document no longer matches the endpoints it was generated from. A
        * generated file nobody regenerates is worse than no file: an integrator reads it, believes it, and
        * builds against an API that changed three releases ago.
        */
      def openApiCheck(): Command[Unit] = Task.Command {
        runMain("kui.gateway.api.openapi.OpenApiDocument", openApiTarget, "--check")()
      }

      object test extends ScalaTests with KuiTests {
        // `services.gateway.application.test` is here for `FakeCapabilityRegistry`. The task asked for
        // that fake to live in `libs/testkit`, and it cannot: `CapabilityRegistry` is a gateway type
        // (ADR-041 §1a), and rule A5 forbids a library module from depending on a service module. One
        // shared fake in the gateway's own test module is the arrangement that keeps both true.
        // `services.topic.contract.jvm.test` is here for one thing: `GoldenDocuments`, the topic
        // service's own committed sample responses. `TopicProxySuite` replays those exact bytes through
        // the gateway's client and asserts that what comes out of the gateway is what the topic service
        // put in. Copying the documents into this module instead would give two files that drift, which
        // is the shape of the defect the suite exists to catch.
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, application.test, topic.contract.jvm.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}",
          // Several suites bind a real port and speak HTTP to it: a header that is stripped by an
          // interceptor is only proven stripped by a request that really travelled through the server.
          mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          // A real tracer, in memory. `traceparent` is only emitted when there is a valid span to
          // propagate, so the header assertion needs a tracer that actually records rather than the
          // no-op one every other suite is happy with.
          mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
          mvn"ch.qos.logback:logback-classic:${Versions.logback}",
          mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
        )
      }
    }

    /** The composition root and the `main`. The only module allowed to name `IO` and to construct
      * anything concrete (ADR-010).
      */
    object app extends KuiJvmModule {
      def moduleDeps = Seq(api, application, libs.config, libs.observability, libs.http)

      /** The gateway's own resources, plus the linked frontend. See `frontend.bundle`: the gateway
        * is the only process a browser talks to, so it is the one that has to carry the JavaScript
        * and the stylesheet.
        */
      override def resources = Task { super.resources() :+ frontend.bundle() }

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"com.softwaremill.macwire::util::${Versions.macwire}",
        // The real HTTP transport under every upstream call. It is named only here, in the composition
        // root (ADR-010): `SttpServiceClient` is handed a backend rather than building one, which is what
        // lets its suite exercise the whole assembly against a stub.
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
        * telemetry exporters. None of them is named in code — Logback is configured by `logback.xml` and
        * the exporters by the OpenTelemetry autoconfigure mechanism — so they stay off the compile
        * classpath, exactly as `libs/observability` explains.
        */
      def runMvnDeps = Seq(
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
        mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
        mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
      )

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          mvn"ch.qos.logback:logback-classic:${Versions.logback}",
          mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
        )
      }
    }
  }

  /** The Topic context (`docs/domain/context-map.md`): browsing topics, their partitions and their
    * settings, read-only in M2.
    *
    * Only `contract` exists here so far. The layers that hold behaviour — `domain`, `application`,
    * `infrastructure`, `api` and `app` — are added by the tasks that have something to put in them,
    * for the same reason M0 gave for the cluster service: an empty module is an invitation to put
    * something in it.
    */
  object topic extends Module {

    /** Business rules and the ports they are stated in terms of. Rule A1 allows it `libs/kernel`
      * and cats-core and nothing else; `KuiPureModule` additionally forbids `var` here.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** Use cases. It may see the domain and the effect libraries, and it may not see the wire:
      * rule A3 fails the build on tapir, circe, `libs/contracts-core` or `libs/http` reaching it.
      * The types a use case returns are its own, and `api` maps them (ADR-033).
      */
    object application extends KuiJvmModule {
      // `libs.cache` carries the `SnapshotCell` the topic snapshot is held in. It has no Kafka
      // dependency, so rule A10 is unaffected, and it is not a wire module, so rule A3 is too.
      def moduleDeps = Seq(domain, libs.cache)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        // The domain's test module carries the generators every suite here builds on. A generator of
        // a domain type cannot live in `libs/testkit`: rule A5 forbids a library depending on a
        // service.
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, services.topic.domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time: the refresh loop's whole contract is about what happens after an interval
          // has passed, and a suite that slept through that would be slow and flaky at once.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-topic-service`.
      *
      * Cross-compiled for the same reason the cluster service's is: the browser decodes exactly what
      * the service encodes, from one source (ADR-003). Rule A2 forbids it any edge into a domain or
      * an application module, which is why the sort field it accepts is declared here rather than
      * imported from `services.topic.domain` — see `TopicSortField`'s own comment.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends ScalaTests with KuiTests with KuiCrossTests
      }

      object js extends Shared with KuiJsModule {
        def moduleDeps = Seq(libs.contractsCore.js, libs.securityCore.js)
        def mvnDeps =
          super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

        object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
      }
    }
  }

  /** `kui-consumer-service`: who consumes what, how far behind they are, and the offset reset.
    *
    * Only `contract` exists here so far. The layers that hold behaviour arrive with the tasks that
    * have something to put in them, for the reason M0 gave for the cluster service: an empty module
    * is an invitation to put something in it.
    */
  object consumer extends Module {

    /** The consumer-group business rules and the ports they are stated in terms of.
      *
      * Rule A1 allows it `libs/kernel` and cats-core, nothing else. Lag arithmetic, the reset
      * planner and the group aggregate live here because every one of them is a rule with a wrong
      * answer that reaches a screen — a fabricated zero, an unclamped offset — and a rule that can
      * be tested with a constructor call should not need an effect to reach it.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends ScalaTests with KuiTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: the snapshot, the five reads, the three mutations and the mutation guard.
      *
      * `libs.cache` carries the `SnapshotCell` the group snapshot is held in, exactly as the
      * cluster service holds its topology. It is not a wire module, so rule A3 is unaffected.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.cache)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends ScalaTests with KuiTests {
        // The domain's test module carries the group fixtures every suite here builds on. They
        // cannot live in `libs/testkit`: rule A5 forbids a library depending on a service.
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time: the snapshot refresh loop's contract is about what happens after thirty
          // seconds, and a suite that slept through that would be slow and flaky at once.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-consumer-service`.
      *
      * Cross-compiled, because the browser decodes exactly what this service encodes, from one
      * source (ADR-003) — and because a suite that runs the *same* assertions on both platforms is
      * the only thing that makes M1's second integration defect impossible: a browser decoding a
      * document nobody sends, defaulting the missing field to an empty list, and rendering "nothing
      * here" with no error anywhere.
      *
      * Rule A2 forbids it any edge to `domain` or `application`. That is why the consumer-group
      * vocabulary it puts on the wire comes from `libs/kernel` and the shapes it shares with the
      * gateway's aggregations come from `libs/contracts-core`, rather than from a service layer.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends ScalaTests with KuiTests with KuiCrossTests
      }

      object js extends Shared with KuiJsModule {
        def moduleDeps = Seq(libs.contractsCore.js, libs.securityCore.js)
        def mvnDeps =
          super.mvnDeps() ++ Seq(mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}")

        object test extends ScalaJSTests with KuiJsTests with KuiCrossTests
      }
    }
  }
}

/** Deployable processes assembled out of the modules above.
  *
  * A service's own `app` module is one deployable; this is the other kind — a process that composes
  * several services rather than serving one. `apps/allinone` is the only member in M0 and the only
  * one planned: ADR-005's whole argument is that there should be exactly two deployment shapes, and
  * that both should run the same code.
  *
  * It is deliberately not under `services`, and the layering rules of ADR-041 are why. Rule A4 forbids
  * anything under `services.gateway` from reaching into another service's private layers, which is what
  * keeps the gateway a composition layer over published contracts. The all-in-one process must do exactly
  * that reaching — it constructs each service's server logic in its own JVM — so it cannot live inside the
  * gateway, and it is not a service either. `apps` is the honest name for what it is: a composition root
  * one level above every service, which is the only place in the build allowed to know all of them.
  */
object apps extends Module {

  /** The whole product in one process, on one port (ADR-005, AIO-001).
    *
    * It depends on the gateway's composition root and on every service's, because composing them is
    * precisely its job. That set of dependencies grows by one service per milestone and nothing else
    * about this module changes.
    */
  object allinone extends KuiJvmModule {
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "apps" / "allinone"

    def moduleDeps = Seq(
      services.gateway.app,
      services.gateway.api,
      services.gateway.application,
      services.cluster.app,
      services.cluster.api,
      libs.config,
      libs.observability,
      libs.http
    )

    /** The frontend, in the jar, for the same reason the gateway carries it: this process serves the
      * browser too. See `frontend.bundle`.
      */
    override def resources = Task { super.resources() :+ frontend.bundle() }

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"com.softwaremill.macwire::util::${Versions.macwire}",
      mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
      // The in-memory transport. `tapir-sttp-stub4-server` is what lets the gateway's own sttp client
      // speak to a service's server logic without a socket, which is how ADR-005's "no second code
      // path" is achieved rather than merely intended. It is a compile dependency of the production
      // code here, not of a test: in this deployment shape it *is* the transport.
      mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
      mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
      mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
      mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}"
    )

    /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
      * telemetry exporters. None is named in code — Logback is configured by the XML in
      * `libs/observability`'s resources and the exporters by OpenTelemetry's autoconfigure mechanism —
      * so they stay off the compile classpath.
      */
    def runMvnDeps = Seq(
      mvn"ch.qos.logback:logback-classic:${Versions.logback}",
      mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
      mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
      mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
    )

    object test extends ScalaTests with KuiTests {
      def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
      )
    }
  }
}

/** The end-to-end tests: a real browser, driven from Scala, against a really running KUI.
  *
  * ADR-018 chose JVM Playwright over the TypeScript one so that the tests are written in the same
  * language and built by the same tool as everything else. There is therefore no `package.json`, no
  * second dependency manager and no second CI toolchain here — `com.microsoft.playwright:playwright`
  * is an ordinary Maven coordinate, and the browser it drives is downloaded once by
  * `./mill e2e.installBrowser`.
  *
  * The module is split the way every other module is: `e2e/src` holds the reusable machinery (the
  * fixtures, the page objects, the fault-isolation scenario) and `e2e/test/src` holds the suites.
  * That is not ceremony. A page object is production-grade code that several suites and several
  * milestones share, and keeping it out of the test source set is what stops it turning into
  * copy-paste inside individual suites.
  *
  * It depends on no other module. The suites talk to KUI the way a user does — over HTTP, through a
  * browser — and giving them the server's classes on the classpath would let an assertion quietly
  * become a unit test against an object it should only be able to see through the wire.
  */
object e2e extends KuiJvmModule {

  /** The one lint rule this module is exempt from is `DisableSyntax.noThrows`, and
    * `.scalafix-e2e.conf` says at length why a test fixture is not production code in that respect.
    */
  def scalafixConfig = Task { Some(mill.api.BuildCtx.workspaceRoot / ".scalafix-e2e.conf") }

  def mvnDeps = Seq(
    mvn"com.microsoft.playwright:playwright:${Versions.playwright}",
    // MUnit is a main dependency and not a test one because `BaseE2ESuite` — an ordinary class in
    // this module that every suite extends — is written against it.
    mvn"org.scalameta::munit::${Versions.munit}",
    mvn"io.circe::circe-core::${Versions.circe}",
    mvn"io.circe::circe-parser::${Versions.circe}"
  )

  /** Downloads the Chromium build this Playwright release speaks to.
    *
    * The two version numbers move together (`Versions.playwright` and `Versions.playwrightBrowser`),
    * and the library refuses to drive any other revision, so this is not "install a browser" but
    * "install *the* browser". It lands in `~/.cache/ms-playwright` and is shared by every later run,
    * which is why CI caches that directory rather than paying the download on each job.
    *
    * `--with-deps` additionally installs the shared libraries the browser needs. It is what a fresh
    * CI runner image requires and it needs root, so it is opt-in here: `./mill e2e.installBrowser
    * --with-deps`.
    */
  def installBrowser(args: String*): Command[Unit] = Task.Command {
    val classPath = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
    val arguments = Seq("install") ++ args ++ Seq("chromium")

    os.proc(
      Seq(s"${System.getProperty("java.home")}/bin/java", "-cp", classPath, "com.microsoft.playwright.CLI") ++
        arguments
    ).call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit)

    println(s"e2e.installBrowser: ${Versions.playwrightBrowser}")
  }

  object test extends ScalaTests with KuiTests {

    /** Everything the suites need to find, handed over as environment variables.
      *
      * A test cannot ask Mill for a task's output while it is running, so the two artefacts it
      * drives — the assembled all-in-one jar and the Compose file — are resolved by the build and
      * passed in. Declaring the jar here is also what makes `./mill e2e.test` build it first: the
      * suite can never run against a stale binary, because there is a real dependency edge between
      * the two rather than a convention that somebody remembers to rebuild.
      */
    override def forkEnv = Task {
      // Building the two images the Compose topology runs, and throwing the tags away. The tags
      // are not needed — `docker-compose.yml` names the images itself — but the dependency edge
      // is, and this is the only way to declare one on a side effect that lives in the Docker
      // daemon rather than in `out/`.
      //
      // Without it, `./mill e2e.test` ran the Compose suites against whichever `kui-gateway` and
      // `kui-cluster` images happened to be on the machine. During M1 that was the M0 images, so
      // the fault-isolation suite — the milestone's headline claim — spent the whole milestone
      // passing against the previous milestone's code, and the failure that finally exposed it was
      // a screenshot of the deleted Ping page.
      val _ = deployment.docker.gateway.docker.build()
      val _ = deployment.docker.cluster.docker.build()

      super.forkEnv() ++ Map(
        "KUI_E2E_ALLINONE_JAR" -> apps.allinone.assembly().path.toString,
        "KUI_E2E_COMPOSE_FILE" ->
          (mill.api.BuildCtx.workspaceRoot / "deployment" / "compose" / "docker-compose.yml").toString,
        "KUI_E2E_COMPOSE_OVERRIDE" ->
          (mill.api.BuildCtx.workspaceRoot / "deployment" / "compose" / "docker-compose.e2e.yml").toString,
        "KUI_E2E_ARTIFACTS" -> (mill.api.BuildCtx.workspaceRoot / "out" / "e2e-artifacts").toString,
        "JAVA_HOME" -> System.getProperty("java.home")
      )
    }

    /** One suite at a time. Both Compose suites drive the same containers, by the fixed names the
      * topology gives them, so two of them running at once would be one suite stopping the service
      * the other had just asserted was up.
      */
    override def testParallelism = false
  }
}

/** The container images KUI ships, and the conventions every future one inherits.
  *
  * Three images in M0 — `kui-gateway`, `kui-cluster` and `kui-allinone` — and each is a thin wrapper
  * around a deployable `app` module rather than something that module grows itself. Keeping them here
  * means "how KUI is packaged" is one file to read and one place to change, and it means adding the
  * eighth service's image is four lines rather than four lines copied into a service's own build
  * definition where nobody will find them.
  *
  * The conventions below are decided once, in [[deployment.docker.KuiImage]], and they are the ones
  * INFRA-001 fixes for every image KUI will ever publish.
  */
object deployment extends Module {

  object docker extends Module {

    /** Where a mounted configuration file is expected, and what the images say to run without one. */
    val ConfigPath: String = "/etc/kui/kui.yaml"

    /** One deployable process, packaged.
      *
      * Every image is `eclipse-temurin:21-jre` (ADR-001) with one assembled jar in it and nothing
      * else. The conventions, and why each one is what it is:
      *
      *   - **Non-root, uid 1001.** A container process that is root is root on the host kernel if
      *     anything ever escapes the namespace, and nothing KUI does needs privilege.
      *
      *     The uid is written numerically and no user is created for it, which is a deliberate
      *     trade. `useradd` would give `whoami` an answer, and it would also write the current day
      *     number into `/etc/shadow` — so the same commit would produce a different image tomorrow,
      *     and the reproducibility this task also asks for would be gone. A numeric `USER` costs a
      *     confusing `whoami` and buys an image that is a function of its source. `HOME` is set to
      *     `/tmp` so that anything looking for a home directory finds a writable one.
      *
      *   - **`-XX:MaxRAMPercentage=75`.** The JVM's default heap sizing reads the *host's* memory on
      *     older runtimes and a container's limit on newer ones; saying it explicitly means the heap
      *     is a stated fraction of whatever limit the orchestrator applied, on every runtime.
      *
      *   - **`-XX:+ExitOnOutOfMemoryError`.** An out-of-memory JVM does not recover; it thrashes,
      *     answers slowly, and passes its own liveness probe while doing it. Exiting turns a silent
      *     degradation into a restart the orchestrator can see and an operator can alert on.
      *
      *   - **`-Djava.io.tmpdir=/tmp`.** Explicit because the images are meant to run with a read-only
      *     root filesystem and a tmpfs at `/tmp`; see `deployment/docker/README.md` for the flags.
      *
      *   - **`HEALTHCHECK` on the liveness endpoint.** `curl` is already in the base image, so this
      *     costs no extra layer and no package installation — which also means no `apt-get`, which is
      *     the other thing that would have made the image a function of the day it was built.
      *
      *   - **The configuration is mounted, never baked in.** The default command names
      *     [[ConfigPath]] and the file is not in the image, so a container started without the mount
      *     stops with the configuration problem printed rather than starting on defaults and
      *     pretending to work.
      *
      *   - **OCI labels from the build.** `revision` in particular: it is the answer to "which commit
      *     is that container running", asked during every incident, and `docker inspect` answers it
      *     without anyone having to exec into anything.
      */
    trait KuiImage extends ScalaModule with DockerModule {
      def scalaVersion = Versions.scala

      /** The deployable this image wraps. */
      def deployable: JavaModule

      /** The repository name, without a tag. */
      def imageName: String

      /** The `main` this image starts. */
      def entryClass: String

      /** The port the process listens on, and the only one the image exposes. */
      def containerPort: Int = 8080

      /** The path the liveness probe is served at.
        *
        * It differs between the gateway and a service and that is not an inconsistency: the gateway
        * serves its own probes under the public `/api/v1` prefix, because everything a browser can
        * reach lives there, while a service serves them at the root of its private world.
        */
      def livenessPath: String

      /** A one-line description of the process, for the OCI `description` label. */
      def imageDescription: String

      def moduleDeps = Seq(deployable)
      def mainClass  = Some(entryClass)

      // The wrapper contributes no code of its own; it exists to name a main class and to be
      // assembled. Saying so explicitly stops Mill looking for directories that will never exist.
      def sources   = Task.Sources()
      def resources = Task.Sources()

      /** The assembled jar, rewritten so that two builds of one commit produce the same bytes.
        *
        * It overrides `assembly` rather than sitting beside it so that everything downstream — the
        * `COPY` in the generated Dockerfile and the copy the contributed docker module makes into
        * its build context — uses the normalised jar without having to know it exists.
        *
        * INFRA-001 asks for an image whose digest is a function of the commit it was built from,
        * and the reason it matters is not tidiness: a digest that changes on every build cannot be
        * used to answer "is the thing running in production the thing we reviewed". Every other
        * piece of the image is already deterministic — the base image is pinned by tag and never
        * re-pulled, the Dockerfile is generated from source, and `SOURCE_DATE_EPOCH` fixes the
        * layer and configuration timestamps. The jar was the one part that was not: Mill stamps
        * each zip entry with the moment it was written, so the last layer's content hash changed
        * every time and carried the whole digest with it.
        *
        * Two things are normalised, and they are the two things `reproducible-builds.org` names:
        *
        *   - **every entry's timestamp becomes a fixed local 1980-01-01**, the earliest instant the
        *     zip format can represent. `setTimeLocal` rather than `setTime` because the latter
        *     converts through the *machine's* time zone, so two developers in different zones would
        *     write different bytes for the same instant and the fix would only work on one of them;
        *   - **entries are written in sorted order**, so a directory listing that came back in a
        *     different order from the filesystem cannot reorder the archive.
        *
        * The shell prefix Mill puts in front of its assembly is dropped, because this jar is only
        * ever started with `java -jar` and a self-executing prefix is one more thing that would have
        * to be byte-stable for no benefit.
        */
      override def assembly: T[PathRef] = Task {
        import java.util.zip.{ZipEntry, ZipFile, ZipOutputStream}
        import scala.jdk.CollectionConverters.*

        val target = Task.dest / "app.jar"
        val fixedTime = java.time.LocalDateTime.of(1980, 1, 1, 0, 0, 0)
        val source = new ZipFile(super.assembly().path.toIO)

        try {
          val output = new ZipOutputStream(os.write.outputStream(target))
          try {
            source
              .entries()
              .asScala
              .toVector
              .sortBy(_.getName)
              .foreach { entry =>
                val copied = new ZipEntry(entry.getName)
                copied.setTimeLocal(fixedTime)
                output.putNextEntry(copied)
                if (!entry.isDirectory) {
                  val content = source.getInputStream(entry)
                  try content.transferTo(output)
                  finally content.close()
                }
                output.closeEntry()
              }
          } finally output.close()
        } finally source.close()

        PathRef(target)
      }

      object docker extends ClassicDockerConfig {
        def tags       = Task { Seq(s"$imageName:${kuiVersion()}") }
        def baseImage  = "eclipse-temurin:21-jre"

        // Never re-pull: a `:latest` base would make the image a function of when it was built,
        // which is exactly what the reproducibility requirement rules out. The tag here is fixed.
        def pullBaseImage = Task { false }

        def exposedPorts = Task { Seq(containerPort) }
        def user         = "1001"
        def envVars      = Task { Map("HOME" -> "/tmp", "TMPDIR" -> "/tmp") }

        def jvmOptions = Seq(
          "-XX:MaxRAMPercentage=75",
          "-XX:+ExitOnOutOfMemoryError",
          "-Djava.io.tmpdir=/tmp"
        )

        def labels = Task {
          Map(
            "org.opencontainers.image.title"       -> imageName,
            "org.opencontainers.image.description" -> imageDescription,
            "org.opencontainers.image.version"     -> kuiVersion(),
            "org.opencontainers.image.revision"    -> gitRevision(),
            "org.opencontainers.image.source"      -> "https://github.com/kui/kui",
            "org.opencontainers.image.licenses"    -> "Apache-2.0"
          )
        }

        /** The generated Dockerfile, plus the three things the contributed module cannot express:
          * the health check, the default command, and the jar's fixed name.
          *
          * The base `dockerfile` task copies the assembly under its own file name, which contains
          * the module path and would change if a module were renamed. Writing the whole file here
          * instead keeps the layout of the image stable and readable — one jar at `/app.jar` — and
          * puts every instruction in one place a reader can check against the conventions above.
          */
        override def dockerfile: T[String] = Task {
          val jar = assembly().path.last
          val renderedLabels = labels()
            .toSeq
            .sortBy(_._1)
            .map((key, value) => s"""LABEL "$key"="$value"""")
            .mkString("\n")
          val renderedEnv = envVars()
            .toSeq
            .sortBy(_._1)
            .map((key, value) => s"ENV $key=$value")
            .mkString("\n")
          val entrypoint =
            (Seq("java") ++ jvmOptions() ++ Seq("-jar", "/app.jar"))
              .map(argument => s""""$argument"""")
              .mkString(", ")

          s"""FROM ${baseImage()}
             |$renderedLabels
             |$renderedEnv
             |EXPOSE $containerPort/tcp
             |COPY $jar /app.jar
             |USER ${user()}
             |HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \\
             |  CMD curl -fsS http://127.0.0.1:$containerPort$livenessPath || exit 1
             |ENTRYPOINT [$entrypoint]
             |CMD ["--config", "$ConfigPath"]
             |""".stripMargin
        }

        /** `SOURCE_DATE_EPOCH` is what BuildKit reads instead of "now" when it has to write a
          * timestamp. See [[build]] for the other two halves of making that actually take effect.
          */
        override def dockerEnv = Task { super.dockerEnv() ++ Map("SOURCE_DATE_EPOCH" -> "0") }

        /** Builds the image so that the same commit produces the same digest.
          *
          * The contributed module's own `build` runs a plain `docker build`, which produces a
          * different digest every time even when nothing has changed. That is not a defect in it —
          * it is BuildKit's default behaviour — but it does defeat the one property INFRA-001 asks
          * for, and the reason that property matters is practical rather than tidy: a digest that
          * changes on every build cannot answer "is the image running in production built from the
          * commit we reviewed".
          *
          * Three flags are what make it hold, and each addresses a different source of drift:
          *
          *   - `rewrite-timestamp=true` on the exporter, which is what actually applies
          *     `SOURCE_DATE_EPOCH` to the files *inside* each layer. Setting the variable alone
          *     fixes the image's `created` field and leaves every copied file stamped with the
          *     moment it was copied, so the layer's content hash still changes on every build.
          *   - `--provenance=false`, because the provenance attestation records when and where the
          *     build ran, which is by definition different every time.
          *   - `--sbom=false`, for the same reason: the attestation is generated per build and
          *     becomes part of the manifest list.
          *
          * `unpack=false` comes along with the first of those because BuildKit refuses to rewrite
          * timestamps while also unpacking the image into the local snapshotter. The image is still
          * registered and still appears in `docker images`; it is unpacked the first time something
          * runs it, which costs a second once and nothing afterwards.
          *
          * The jar being copied in is normalised separately — see `assembly` above — because none of
          * these flags can help with an input whose own bytes differ.
          */
        override def build: T[Seq[String]] = Task {
          val context = Task.dest
          val jar = assembly().path

          os.copy.over(jar, context / jar.last)
          os.write.over(context / "Dockerfile", dockerfile())

          val built = tags().head

          os.proc(
            executable(),
            "buildx",
            "build",
            "--provenance=false",
            "--sbom=false",
            "--output",
            s"type=docker,name=$built,rewrite-timestamp=true,unpack=false",
            context
          ).call(stdout = os.Inherit, stderr = os.Inherit, env = dockerEnv())

          tags().tail.foreach(extra =>
            os.proc(executable(), "tag", built, extra)
              .call(stdout = os.Inherit, stderr = os.Inherit, env = dockerEnv())
          )

          Task.log.info(s"built ${tags().mkString(", ")}")
          tags()
        }
      }
    }

    /** The one process a browser talks to. */
    object gateway extends KuiImage {
      def deployable       = services.gateway.app
      def imageName        = "kui-gateway"
      def entryClass       = "kui.gateway.app.Main"
      def livenessPath     = "/api/v1/health/live"
      def imageDescription = "KUI gateway: the single origin a browser talks to"
    }

    /** The Cluster Registry and Topology service. */
    object cluster extends KuiImage {
      def deployable       = services.cluster.app
      def imageName        = "kui-cluster"
      def entryClass       = "kui.cluster.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI cluster registry and topology service"
    }

    /** The whole product in one process (ADR-005). */
    object allinone extends KuiImage {
      def deployable       = apps.allinone
      def imageName        = "kui-allinone"
      def entryClass       = "kui.allinone.AllInOne"
      def livenessPath     = "/api/v1/health/live"
      def imageDescription = "KUI all-in-one: the gateway and every service in one process"
    }
  }
}

// -------------------------------------------------------------------------------------------------
// The developer loop (INFRA-003)
// -------------------------------------------------------------------------------------------------

/** Where `./mill devStart` writes the running process's id and its log. */
private def devPidFile   = mill.api.BuildCtx.workspaceRoot / "out" / "dev.pid"
private def devLogFile   = mill.api.BuildCtx.workspaceRoot / "out" / "dev.log"

/** The whole product on one port, with the frontend served straight out of the linker's output
  * directory.
  *
  * ==How the frontend gets served without being packaged==
  *
  * `StaticRoutes` serves `/ui/…` from the classpath under `/web`, so `/web/main.js` is what a browser
  * asks for. In a release build those files are bundled into the gateway's resources. Bundling them
  * for development would mean a copy step between "the linker wrote a new main.js" and "the server
  * can see it", and that copy step is exactly the thing that makes a frontend loop feel slow.
  *
  * So no copying happens at all. Two extra classpath entries are put in *front* of the module
  * classpath, each a directory whose `web` is a symbolic link to a task's output directory:
  *
  * {{{
  * out/dev-assets/js/web   ->  out/frontend/uiShell/fastLinkJS.dest   (main.js and every chunk)
  * out/dev-assets/css/web  ->  out/frontend/css.dest                  (kui.css)
  * }}}
  *
  * A classloader searches classpath entries in order and takes the first hit, so `/web/main.js`
  * resolves through the first link, `/web/kui.css` through the second, and `/web/index.html` — which
  * is in neither — falls through to the gateway's own resources. Re-running the linker rewrites the
  * files behind the first link, and a browser refresh is the whole loop: nothing is copied, nothing
  * is restarted, and no proxy is involved because the assets and the API share an origin (ADR-012
  * amendment 1).
  *
  * ==The log format==
  *
  * `text`, because a person is watching this. The images default to JSON, which is right when a log
  * collector is reading and unreadable when a human is. No OTLP exporter is configured either, so a
  * first run has no exporter warnings in it to explain away.
  */
def dev(): Task.Command[Unit] = Task.Command {
  val classPath = devClassPath()
  val port = devPortOf(Task.env)
  println(devBanner(port))
  os.proc(devCommand(classPath, port))
    .call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit, check = false)
  ()
}

/** The same server, detached, so that the frontend can be re-linked while it runs.
  *
  * This exists because of a constraint that is not obvious until it bites: Mill serialises
  * invocations on its output directory. A `./mill dev` holding the terminal also holds that lock, so
  * `./mill frontend.uiShell.fastLinkJS` in a second terminal waits instead of linking, and the loop
  * the previous paragraph describes never gets to run. Detaching releases the lock.
  *
  * The pair is therefore:
  *
  * {{{
  * ./mill devStart                            # the server, in the background
  * ./mill -w frontend.uiShell.fastLinkJS      # re-links on every save; refresh the browser
  * ./mill devStop                             # when you are done
  * }}}
  *
  * `./mill dev` is still the right thing for a first run — it puts the log on the screen and stops
  * with Ctrl-C — and this is the right thing once you are editing.
  */
def devStart(): Task.Command[Unit] = Task.Command {
  stopDevServer()

  val classPath = devClassPath()
  val port = devPortOf(Task.env)
  os.write.over(devLogFile, "")

  val process = os
    .proc(devCommand(classPath, port))
    .spawn(
      cwd = mill.api.BuildCtx.workspaceRoot,
      stdout = devLogFile,
      // Appended to the same file rather than discarded: a bind failure — the commonest way this
      // command does not work — is written to standard error, and swallowing it would leave a
      // developer with a server that is silently not there.
      stderr = os.PathAppendRedirect(devLogFile),
      stdin = os.Inherit
    )

  os.write.over(devPidFile, process.wrapped.pid().toString)

  println(devBanner(port))
  println(s"  running in the background as pid ${process.wrapped.pid()}")
  println(s"  logs:  tail -f ${devLogFile.relativeTo(mill.api.BuildCtx.workspaceRoot)}")
  println(s"  watch: ./mill -w frontend.uiShell.fastLinkJS")
  println(s"  stop:  ./mill devStop")
}

/** Stops whatever `devStart` started. Saying nothing at all when there is nothing running, because a
  * stop command that fails when the thing is already stopped is a stop command people wrap in `|| true`.
  */
def devStop(): Task.Command[Unit] = Task.Command {
  if (stopDevServer()) println("stopped the development server") else println("nothing was running")
}

/** The classpath the development server runs on: the two live asset links, then everything the
  * all-in-one process would normally have.
  */
private def devClassPath = Task.Anon {
  val linked = frontend.uiShell.fastLinkJS().dest.path
  val stylesheet = frontend.css().path

  val js = devAssetLink(mill.api.BuildCtx.workspaceRoot / "out" / "dev-assets" / "js", linked)
  val css = devAssetLink(mill.api.BuildCtx.workspaceRoot / "out" / "dev-assets" / "css", stylesheet / os.up)

  (Seq(js, css) ++ apps.allinone.runClasspath().map(_.path)).mkString(java.io.File.pathSeparator)
}

/** Creates `<root>/web -> target` and answers `<root>`, which is what goes on the classpath.
  *
  * A symbolic link rather than a copy, because the point of the whole arrangement is that the server
  * reads whatever the linker most recently wrote. A copy would be a snapshot, and a snapshot is a
  * stale page.
  */
private def devAssetLink(root: os.Path, target: os.Path): os.Path = {
  val link = root / "web"
  os.remove.all(root)
  os.makeDir.all(root)
  os.symlink(link, target)
  root
}

/** The port the development server listens on. `KUI_PORT` overrides it, because 8080 is the most
  * contended port on a developer's machine and "it says nothing and answers nothing" is a miserable
  * first experience of a project.
  *
  * `Task.env` and not `sys.env`: Mill runs tasks inside a long-lived daemon, so `sys.env` is the
  * environment that daemon happened to be started with, not the one the developer just typed the
  * command in. Reading the wrong one produces a variable that appears to be ignored — and works
  * again, confusingly, after an unrelated `./mill shutdown`.
  */
private def devPortOf(env: Map[String, String]): String = env.getOrElse("KUI_PORT", "8080")

private def devCommand(classPath: String, devPort: String): Seq[String] =
  Seq(
    s"${System.getProperty("java.home")}/bin/java",
    "-cp",
    classPath,
    "kui.allinone.AllInOne",
    s"--kui.server.port=$devPort",
    // Readable on a terminal, and no exporter to fail to reach.
    "--kui.telemetry.logFormat=text",
    // Plain HTTP on localhost, so the session cookie cannot carry `Secure` or the browser will not
    // send it back. The process says so loudly on every start, and the warning is right.
    "--kui.server.devInsecureCookies=true"
  )

private def devBanner(devPort: String): String =
  s"""kui development server
     |  open   http://localhost:$devPort/ui/
     |  assets out/frontend/uiShell/fastLinkJS.dest (served live; re-link and refresh)""".stripMargin

/** Kills a previously started development server. Answers whether there was one. */
private def stopDevServer(): Boolean =
  if (!os.exists(devPidFile)) false
  else {
    val pid = scala.util.Try(os.read(devPidFile).trim.toLong).toOption
    os.remove(devPidFile)
    pid.exists { id =>
      val handle = ProcessHandle.of(id)
      handle.isPresent && handle.get().destroy()
    }
  }

/** The commit this build is being run from, or `unknown` when there is no git checkout.
  *
  * `unknown` rather than a failed build, because a release tarball and many build containers have no
  * `.git` directory and an image built from one is still a perfectly good image — it just cannot say
  * which commit it came from, which the label then states plainly instead of guessing.
  */
def gitRevision: T[String] = Task {
  git("rev-parse", "HEAD").map(_.trim).filter(_.nonEmpty).getOrElse(BuildFacts.Unknown)
}

/** Small programs the build runs. They are ordinary modules so that their logic is unit-tested like
  * any other code, rather than living as untested script inside a Mill task.
  */
object tools extends Module {

  /** Renders `docs/api/error-codes.md` from the `ErrorCode` enum (KERN-008, ADR-034 amendment 2). */
  object errorCodes extends KuiJvmModule {
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "tools" / "error-codes"

    def moduleDeps = Seq(libs.kernel.jvm)

    object test extends ScalaTests with KuiTests
  }
}

/** Documents generated from code.
  *
  * A generated document is only trustworthy if something fails when it goes stale, so every task
  * here has a `--check` mode that CI runs: `./mill docs.errorCodes` writes the file, and
  * `./mill docs.errorCodes --check` fails when the committed file no longer matches the source it
  * was generated from.
  */
object docs extends Module {

  /** Where the generated table is committed. */
  private def errorCodesTarget: String =
    (mill.api.BuildCtx.workspaceRoot / "docs" / "api" / "error-codes.md").toString

  def errorCodes(args: String*): Command[Unit] = Task.Command {
    tools.errorCodes.run(Task.Anon(mill.api.Args(errorCodesTarget +: args)))()
  }
}

/** A module that exists only to be resolved, never compiled.
  *
  * It declares every Maven coordinate M0 will eventually use. `resolveAll` downloads the lot, so a
  * typo in a version string fails on the first day rather than on the day the module that needs the
  * library is finally written. It is deliberately not part of any real module's classpath.
  */
object depsSmoke extends KuiModule {
  def sources = Task.Sources()

  def mvnDeps = Seq(
    // Runtime core
    mvn"org.typelevel::cats-core::${Versions.cats}",
    mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
    mvn"co.fs2::fs2-core::${Versions.fs2}",
    mvn"co.fs2::fs2-io::${Versions.fs2}",
    // HTTP and contracts
    mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-iron::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-files::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-otel4s-tracing::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-metrics::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
    mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::circe::${Versions.sttp}",
    // JSON, config, validation, wiring
    mvn"io.circe::circe-core::${Versions.circe}",
    mvn"io.circe::circe-parser::${Versions.circe}",
    mvn"io.circe::circe-generic::${Versions.circe}",
    mvn"io.circe::circe-yaml::${Versions.circeYaml}",
    mvn"is.cir::ciris::${Versions.ciris}",
    mvn"is.cir::ciris-circe-yaml::${Versions.ciris}",
    mvn"io.github.iltotore::iron::${Versions.iron}",
    mvn"io.github.iltotore::iron-circe::${Versions.iron}",
    mvn"io.github.iltotore::iron-cats::${Versions.iron}",
    mvn"io.github.iltotore::iron-ciris::${Versions.iron}",
    mvn"com.softwaremill.macwire::macros::${Versions.macwire}",
    mvn"com.softwaremill.macwire::util::${Versions.macwire}",
    // Logging and telemetry
    mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
    mvn"org.typelevel::log4cats-slf4j::${Versions.log4cats}",
    mvn"org.slf4j:slf4j-api:${Versions.slf4j}",
    mvn"ch.qos.logback:logback-classic:${Versions.logback}",
    mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
    mvn"org.typelevel::otel4s-core::${Versions.otel4s}",
    mvn"org.typelevel::otel4s-oteljava::${Versions.otel4s}",
    mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
    mvn"io.opentelemetry:opentelemetry-sdk:${Versions.otelSdk}",
    mvn"io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:${Versions.otelSdk}",
    mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
    // Tests
    mvn"org.scalameta::munit::${Versions.munit}",
    mvn"org.scalameta::munit-scalacheck::${Versions.munitScalacheck}",
    mvn"org.scalacheck::scalacheck::${Versions.scalacheck}",
    mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
    mvn"org.typelevel::discipline-munit::${Versions.disciplineMunit}",
    mvn"com.dimafeng::testcontainers-scala-munit::${Versions.testcontainers}",
    // Frontend. These are Scala.js artifacts, named in full so a plain JVM resolution can still
    // prove the coordinates exist without a Scala.js module being declared yet (BUILD-003).
    mvn"com.raquo:laminar_sjs1_3:${Versions.laminar}",
    mvn"com.raquo:airstream_sjs1_3:${Versions.laminar}",
    mvn"com.raquo:waypoint_sjs1_3:${Versions.waypoint}",
    mvn"org.scala-js:scalajs-dom_sjs1_3:${Versions.scalajsDom}",
    mvn"org.scala-js:scalajs-library_2.13:${Versions.scalaJs}",
    mvn"io.github.cquiroz:scala-java-time_sjs1_3:${Versions.scalaJavaTime}",
    mvn"com.raquo:domtestutils_sjs1_3:${Versions.domtestutils}"
  )
}

/** The layering rules of ADR-041 and the tests that prove each one fires.
  *
  * The rules themselves are compiled twice: once here, so they can be unit-tested against synthetic
  * module graphs, and once by the meta-build (`mill-build/build.mill`), so that `checkArchitecture`
  * below runs exactly the code these tests cover.
  */
object `build-tests` extends KuiPureModule {
  object test extends ScalaTests with KuiTests
}

/** Everything in this build that could have a dependency edge, as plain data.
  *
  * `depsSmoke` is excluded: it is a resolution probe, not a real module, and its whole purpose is
  * to declare every coordinate in the project at once.
  */
private def declaredModules: Seq[JavaModule] = moduleInternal.modules.collect {
  case m: JavaModule if m.moduleSegments.render != "depsSmoke" => m
}.toSeq

private def moduleGraph = Task.Anon {
  val modules           = declaredModules
  val declaredLibraries = Task.traverse(declaredModules)(_.mvnDeps)()

  modules.zip(declaredLibraries).map { (module, libraries) =>
    ModuleFacts(
      id = module.moduleSegments.render,
      moduleDeps = module.moduleDeps.map(_.moduleSegments.render).toSet,
      mvnDeps = libraries.map(coordinateOf).toSet
    )
  }.toList
}

/** `mvn"org.typelevel::cats-core::2.13.0"` becomes `org.typelevel:cats-core`.
  *
  * The version is dropped because the rules are about which library, not which release, and the
  * Scala suffix is dropped because `cats-core_3` and `cats-core_sjs1_3` are the same library.
  */
private def coordinateOf(dep: mill.scalalib.Dep): String = {
  val organization = dep.dep.module.organization.value
  val artifact     = dep.dep.module.name.value
  val bare = List("_sjs1_3", "_sjs1_2.13", "_3", "_2.13")
    .find(artifact.endsWith)
    .fold(artifact)(suffix => artifact.dropRight(suffix.length))
  s"$organization:$bare"
}

/** Fails the build on any module dependency that breaks the layering rules of ADR-041.
  *
  * This is what stops the hexagonal structure decaying. Nobody sets out to make `application`
  * depend on Tapir; someone needs one type, adds one edge, and the edge is invisible in every
  * later code review because reviewers read diffs, not dependency graphs. The check reports the
  * rule, both modules and the reason, so whoever trips it learns why in the same minute.
  */
def checkArchitecture(): Task.Command[Unit] = Task.Command {
  val modules    = moduleGraph()
  val violations = ArchitectureRules.check(modules)

  if (violations.isEmpty) {
    println(
      s"checkArchitecture: ${modules.size} modules, ${ArchitectureRules.ruleCount} rules, " +
        "no layering violations"
    )
  } else {
    val report = violations.map(v => s"  ${v.message}").mkString("\n")
    Task.fail(s"${violations.size} layering violation(s):\n$report")
  }
}

/** Downloads every coordinate M0 pins and prints how many were fetched. Exits non-zero on the first
  * version that does not exist, which is the whole point of the task.
  */
/** The pinned versions that something outside the build has to read back.
  *
  * `Versions` above is a plain Scala object, evaluated while the build definition is being
  * compiled, so `./mill show Versions.playwright` cannot work — Mill can only show a *task*. CI
  * needs the Playwright numbers as text (it installs the browser before the e2e job runs), so those
  * two are re-exported here as tasks. Everything else is read by the build itself and needs no
  * external accessor.
  */
object versions extends Module {
  def playwright: T[String]        = Task { Versions.playwright }
  def playwrightBrowser: T[String] = Task { Versions.playwrightBrowser }
}

def resolveAll(): Task.Command[Int] = Task.Command {
  val jars = depsSmoke.resolvedMvnDeps()
  println(s"resolved ${jars.toSeq.size} artifacts for ${depsSmoke.mvnDeps().size} pinned coordinates")
  jars.toSeq.size
}
